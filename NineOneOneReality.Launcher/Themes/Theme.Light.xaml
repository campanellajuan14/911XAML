<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LIGHT theme palette and brushes. Same Brush.Theme.* keys as the
        dark theme so ControlTemplates and Views are interchangeable
        between themes by simply swapping the merged dictionary at the
        Window level.

        Hex values sampled from "Light - Instructor - folder-view.png".
    -->

    <!--  ===== Color palette ===== -->

    <Color x:Key="Color.Theme.Background">#FFF5F6F8</Color>
    <!--  pale cool gray main canvas  -->

    <Color x:Key="Color.Theme.Surface">#FFFFFFFF</Color>
    <!--  card / panel background  -->

    <Color x:Key="Color.Theme.Surface.Elevated">#FFFAFBFC</Color>

    <Color x:Key="Color.Theme.Sidebar">#FFFFFFFF</Color>
    <!--  white sidebar (per source PNG)  -->

    <Color x:Key="Color.Theme.Sidebar.ItemHover">#FFFFEDDB</Color>
    <Color x:Key="Color.Theme.Sidebar.ItemSelected">#FFFFE0BF</Color>
    <!--  light orange wash for selected nav item (matches Dashboard row)  -->

    <Color x:Key="Color.Theme.Border">#FFE0E3E8</Color>
    <Color x:Key="Color.Theme.Border.Subtle">#FFEEF0F3</Color>
    <Color x:Key="Color.Theme.Divider.Orange">#80FF7A00</Color>

    <Color x:Key="Color.Theme.Foreground">#FF1F2227</Color>
    <Color x:Key="Color.Theme.Foreground.Soft">#FF3A3D44</Color>
    <Color x:Key="Color.Theme.Foreground.Muted">#FF6B6F76</Color>
    <Color x:Key="Color.Theme.Foreground.Subtle">#FF9AA0A8</Color>

    <Color x:Key="Color.Theme.IconNeutral">#FF424D56</Color>
    <!--  matches the Dashboard.svg cls-1 fill in light context  -->

    <Color x:Key="Color.Theme.UserAvatar.Bg">#FFEEF0F3</Color>
    <Color x:Key="Color.Theme.UserAvatar.Border">#FFD0D5DB</Color>

    <!--  ===== Brushes (same keys as Theme.Dark.xaml) ===== -->

    <SolidColorBrush x:Key="Brush.Theme.Background" Color="{StaticResource Color.Theme.Background}" />
    <SolidColorBrush x:Key="Brush.Theme.Surface" Color="{StaticResource Color.Theme.Surface}" />
    <SolidColorBrush x:Key="Brush.Theme.Surface.Elevated" Color="{StaticResource Color.Theme.Surface.Elevated}" />

    <SolidColorBrush x:Key="Brush.Theme.Sidebar" Color="{StaticResource Color.Theme.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Theme.Sidebar.ItemHover" Color="{StaticResource Color.Theme.Sidebar.ItemHover}" />
    <SolidColorBrush x:Key="Brush.Theme.Sidebar.ItemSelected" Color="{StaticResource Color.Theme.Sidebar.ItemSelected}" />

    <SolidColorBrush x:Key="Brush.Theme.Border" Color="{StaticResource Color.Theme.Border}" />
    <SolidColorBrush x:Key="Brush.Theme.Border.Subtle" Color="{StaticResource Color.Theme.Border.Subtle}" />
    <SolidColorBrush x:Key="Brush.Theme.Divider.Orange" Color="{StaticResource Color.Theme.Divider.Orange}" />

    <SolidColorBrush x:Key="Brush.Theme.Foreground" Color="{StaticResource Color.Theme.Foreground}" />
    <SolidColorBrush x:Key="Brush.Theme.Foreground.Soft" Color="{StaticResource Color.Theme.Foreground.Soft}" />
    <SolidColorBrush x:Key="Brush.Theme.Foreground.Muted" Color="{StaticResource Color.Theme.Foreground.Muted}" />
    <SolidColorBrush x:Key="Brush.Theme.Foreground.Subtle" Color="{StaticResource Color.Theme.Foreground.Subtle}" />

    <SolidColorBrush x:Key="Brush.Theme.IconNeutral" Color="{StaticResource Color.Theme.IconNeutral}" />

    <SolidColorBrush x:Key="Brush.Theme.UserAvatar.Bg" Color="{StaticResource Color.Theme.UserAvatar.Bg}" />
    <SolidColorBrush x:Key="Brush.Theme.UserAvatar.Border" Color="{StaticResource Color.Theme.UserAvatar.Border}" />

    <!--  Active light hero: soft edge wash so title / wordmark stay legible over
          cityscape + orange glow layers (same L8 slot as dark; stronger than
          near-transparent placeholder used before M3).  -->
    <LinearGradientBrush x:Key="Brush.Theme.HeroVignette" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0.0" Color="#55F5F6F8" />
        <GradientStop Offset="0.45" Color="#00F5F6F8" />
        <GradientStop Offset="0.55" Color="#00F5F6F8" />
        <GradientStop Offset="1.0" Color="#66E8EAEF" />
    </LinearGradientBrush>

</ResourceDictionary>
