<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        All UI text: Roboto Condensed (embedded TTF under Resources/Fonts).
        Font.Montserrat is a legacy key name; it resolves to the same family.
    -->
    <FontFamily x:Key="Font.RobotoCondensed">pack://application:,,,/Resources/Fonts/#Roboto Condensed</FontFamily>
    <FontFamily x:Key="Font.Montserrat">pack://application:,,,/Resources/Fonts/#Roboto Condensed</FontFamily>

    <sys:Double x:Key="Font.Size.HeroTitle">160</sys:Double>
    <sys:Double x:Key="Font.Size.HeroTitleMain">88</sys:Double>
    <sys:Double x:Key="Font.Size.HeroTitleAccent">76</sys:Double>
    <sys:Double x:Key="Font.Size.Subtitle">58</sys:Double>
    <sys:Double x:Key="Font.Size.SectionLabel">32</sys:Double>
    <sys:Double x:Key="Font.Size.PrimaryButton">38</sys:Double>
    <sys:Double x:Key="Font.Size.HeaderBrand">32</sys:Double>
    <sys:Double x:Key="Font.Size.SidebarBrand">25</sys:Double>
    <sys:Double x:Key="Font.Size.HeaderMeta">20</sys:Double>
    <sys:Double x:Key="Font.Size.NavItem">15</sys:Double>
    <sys:Double x:Key="Font.Size.NavSection">15</sys:Double>
    <sys:Double x:Key="Font.Size.Body">16</sys:Double>
    <sys:Double x:Key="Font.Size.BodySmall">14</sys:Double>
    <sys:Double x:Key="Font.Size.Caption">12</sys:Double>

    <!--  App-wide default: every page inherits Roboto Condensed unless overridden.  -->
    <Style TargetType="{x:Type Control}">
        <Setter Property="FontFamily" Value="{StaticResource Font.RobotoCondensed}" />
    </Style>
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.RobotoCondensed}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="{StaticResource Font.RobotoCondensed}" />
    </Style>
    <Style TargetType="{x:Type Label}">
        <Setter Property="FontFamily" Value="{StaticResource Font.RobotoCondensed}" />
    </Style>
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="{StaticResource Font.RobotoCondensed}" />
    </Style>
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="{StaticResource Font.RobotoCondensed}" />
    </Style>
    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="FontFamily" Value="{StaticResource Font.RobotoCondensed}" />
    </Style>
    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="FontFamily" Value="{StaticResource Font.RobotoCondensed}" />
    </Style>

    <Style x:Key="Text.Hero" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.RobotoCondensed}" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.HeroTitle}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Text.Subtitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.RobotoCondensed}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Subtitle}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="Text.SectionLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.RobotoCondensed}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.SectionLabel}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="Text.HeaderBrand" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.RobotoCondensed}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.HeaderBrand}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="Text.HeaderMeta" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.RobotoCondensed}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.HeaderMeta}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="Text.NavItem" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.RobotoCondensed}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.NavItem}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="Text.NavSection" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.RobotoCondensed}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.NavSection}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="Text.Body" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.RobotoCondensed}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

</ResourceDictionary>
