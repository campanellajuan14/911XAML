<Window x:Class="NineOneOneReality.Launcher.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:assist="clr-namespace:NineOneOneReality.Launcher"
        xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        Title="9-1-1 Reality — Dashboard"
        Width="1920"
        Height="1080"
        MinWidth="1280"
        MinHeight="720"
        Background="{DynamicResource Brush.Theme.Background}"
        FontFamily="{StaticResource Font.Montserrat}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <!--
        Instructor Dashboard — Folder View (light reference: client folder-view mock).
        Theme + Brush.Dashboard.* are merged in code after InitializeComponent (see DashboardWindow.xaml.cs).
        Brush.Dashboard.* in ControlTemplate.Triggers use DynamicResource so lookups reach the window-merged theme dictionary (StaticResource from a template trigger often misses merged keys).
    -->

    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="Sidebar.Divider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="20,12,20,12" />
                <Setter Property="Background" Value="{DynamicResource Brush.Theme.Border.Subtle}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="Dashboard.PrimaryCompact" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Width" Value="NaN" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="20,0" />
                <Setter Property="FontSize" Value="{StaticResource Font.Size.BodySmall}" />
            </Style>

            <Style x:Key="Dashboard.ButtonOutline" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Brush.Theme.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Theme.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Theme.Foreground}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="{StaticResource Font.Size.BodySmall}" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Dashboard.ToolbarOutlineHover}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Dashboard.AccentWarm}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Dashboard.ToolbarOutlinePressed}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Dashboard.AccentWarmPressed}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  Toolbar: pill buttons (corner radius = half height ≈ 50% round).  -->
            <Style x:Key="Dashboard.ToolbarPillPrimary" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Brush.Dashboard.AccentWarm}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontFamily" Value="{StaticResource Font.Montserrat}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="{StaticResource Font.Size.BodySmall}" />
                <Setter Property="Padding" Value="22,0" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="21"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Dashboard.AccentWarmHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Dashboard.AccentWarmPressed}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Dashboard.ToolbarPillOutline" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Brush.Theme.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Theme.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Theme.Foreground}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="{StaticResource Font.Size.BodySmall}" />
                <Setter Property="Padding" Value="22,0" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="21"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Dashboard.ToolbarOutlineHover}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Dashboard.AccentWarm}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Dashboard.ToolbarOutlinePressed}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Dashboard.AccentWarmPressed}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  Folder scope chips inside path bar (reference: pale orange pills + hex mark).  -->
            <Style x:Key="Dashboard.FolderScopeChip" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Dashboard.AccentWarm}" />
                <Setter Property="FontSize" Value="{StaticResource Font.Size.BodySmall}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Chip"
                                    Padding="10,6"
                                    Background="{DynamicResource Brush.Dashboard.ChipSurface}"
                                    BorderBrush="{DynamicResource Brush.Dashboard.ChipBorder}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="10"
                                          Height="10"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"
                                          Data="M5,0 L9.33,2.5 L9.33,7.5 L5,10 L0.67,7.5 L0.67,2.5 Z"
                                          Fill="{DynamicResource Brush.Dashboard.AccentWarm}"
                                          Stretch="Uniform" />
                                    <ContentPresenter VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"
                                                      TextElement.Foreground="{DynamicResource Brush.Dashboard.AccentWarm}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Dashboard.ChipSurfaceChecked}" />
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Dashboard.AccentWarm}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Dashboard.ChipSurfaceHover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  Available Folders rows: hover lift + orange border (Border is not a Button — use Style.Triggers).  -->
            <Style x:Key="Dashboard.FolderListRow" TargetType="Border">
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="{DynamicResource Brush.Dashboard.RowSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Theme.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Dashboard.RowSurfaceHover}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Dashboard.AccentWarm}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Dashboard.FolderListRowSelected"
                   TargetType="Border"
                   BasedOn="{StaticResource Dashboard.FolderListRow}">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Dashboard.AccentWarm}" />
            </Style>

            <Style x:Key="Dashboard.PathTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource Brush.Theme.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Theme.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Theme.Foreground}" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="FontSize" Value="{StaticResource Font.Size.BodySmall}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="Dashboard.ModelTextBox.Inner" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Theme.Foreground}" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontSize" Value="{StaticResource Font.Size.BodySmall}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CaretBrush" Value="{DynamicResource Brush.Theme.Foreground}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Sidebar (below full-width header; fills remaining window height).  -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="Transparent"
                Margin="14,14,12,14"
                Padding="0">
            <Border Background="{DynamicResource Brush.Theme.Sidebar}"
                    BorderBrush="{DynamicResource Brush.Theme.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="14,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Brand lockup: circular 911 headset badge (same asset as main header / Active sidebar).  -->
                    <StackPanel Grid.Row="0" Margin="14,18,14,10" HorizontalAlignment="Center">
                        <Border Width="72"
                                Height="72"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource Brush.Theme.Sidebar}"
                                CornerRadius="36"
                                ClipToBounds="True"
                                SnapsToDevicePixels="True">
                            <Image Width="72"
                                   Height="72"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   SnapsToDevicePixels="True"
                                   Source="/Resources/Images/SidebarNav/instructor-sidebar-badge.png"
                                   Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="{StaticResource Font.Size.SidebarBrand}"
                                   FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Brush.Theme.Foreground}"
                                   Text="9-1-1 REALITY" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,4,0,4">
                        <RadioButton Content="Dashboard"
                                     assist:NavIconAssist.SvgIcon="pack://application:,,,/Resources/Images/DashboardNav/dashboard.svg"
                                     IsChecked="True"
                                     Style="{StaticResource NavButtonStyle.Dashboard}" />
                        <RadioButton assist:NavIconAssist.SvgIcon="pack://application:,,,/Resources/Images/DashboardNav/start-simulation.svg"
                                     Content="Start Simulation"
                                     Style="{StaticResource NavButtonStyle.Dashboard}" />
                        <RadioButton assist:NavIconAssist.SvgIcon="pack://application:,,,/Resources/Images/DashboardNav/user-manuals.svg"
                                     Content="User Manuals / IT Info"
                                     Style="{StaticResource NavButtonStyle.Dashboard}" />
                        <RadioButton assist:NavIconAssist.SvgIcon="pack://application:,,,/Resources/Images/DashboardNav/video-tutorials.svg"
                                     Content="Video Tutorials"
                                     Style="{StaticResource NavButtonStyle.Dashboard}" />
                        <RadioButton assist:NavIconAssist.SvgIcon="pack://application:,,,/Resources/Images/DashboardNav/academy-911.svg"
                                     Content="9-1-1 Academy / AI"
                                     Style="{StaticResource NavButtonStyle.Dashboard}" />
                        <RadioButton assist:NavIconAssist.SvgIcon="pack://application:,,,/Resources/Images/DashboardNav/listen-to-recording.svg"
                                     Content="Listen To Recordings"
                                     Style="{StaticResource NavButtonStyle.Dashboard}" />
                        <RadioButton Content="Settings"
                                     assist:NavIconAssist.SvgIcon="pack://application:,,,/Resources/Images/DashboardNav/settings.svg"
                                     Style="{StaticResource NavButtonStyle.Dashboard}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom" />

                    <Border Grid.Row="3" Style="{StaticResource Sidebar.Divider}" />

                    <StackPanel Grid.Row="4">
                        <TextBlock Margin="28,0,14,10"
                                   FontSize="{StaticResource Font.Size.NavSection}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Dashboard.AccentWarm}"
                                   Text="SYSTEM" />
                        <RadioButton GroupName="DashboardSystem"
                                     assist:NavIconAssist.IdleFill="{DynamicResource Brush.NavIcon.Restart}"
                                     Content="Restart"
                                     Style="{StaticResource NavButtonStyle.Dashboard}"
                                     Tag="{StaticResource Icon.Restart}" />
                        <RadioButton GroupName="DashboardSystem"
                                     assist:NavIconAssist.IdleFill="{DynamicResource Brush.NavIcon.Shutdown}"
                                     Content="Shutdown"
                                     Style="{StaticResource NavButtonStyle.Dashboard}"
                                     Tag="{StaticResource Icon.Shutdown}" />
                    </StackPanel>

                    <Border Grid.Row="5" Style="{StaticResource Sidebar.Divider}" />

                    <Border Grid.Row="6"
                            Margin="14,16,14,18"
                            Padding="12,10"
                            Background="{DynamicResource Brush.Theme.Surface}"
                            BorderThickness="0"
                            CornerRadius="10">
                        <Grid Grid.IsSharedSizeScope="True"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="InstructorChipBalance" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="InstructorChipBalance" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0"
                                     Width="30"
                                     Height="30"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Canvas.Left="2"
                                             Canvas.Top="2"
                                             Width="20"
                                             Height="20"
                                             Fill="Transparent"
                                             Stroke="{DynamicResource Brush.Theme.Foreground}"
                                             StrokeThickness="1.35" />
                                    <Ellipse Canvas.Left="8"
                                             Canvas.Top="6"
                                             Width="8"
                                             Height="8"
                                             Fill="Transparent"
                                             Stroke="{DynamicResource Brush.Theme.Foreground}"
                                             StrokeThickness="1.35"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Top" />
                                    <Path Data="M5.75,17.75 Q12,13.75 18.25,17.75"
                                          Fill="Transparent"
                                          Stroke="{DynamicResource Brush.Theme.Foreground}"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.35" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Theme.Foreground}"
                                       Text="INSTRUCTOR" />
                            <Border Grid.Column="2"
                                    Background="Transparent" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!--
          Header: left INSTRUCTOR 2 + header-navigation-user.svg; center 911-reality-logo.svg;
          right SIMULATION + READY + clock.
        -->
        <ContentControl Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource HeaderBarStyle.Active}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Left: instructor headset user (header-navigation-user.svg) + INSTRUCTOR 2.  -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="40"
                            Height="40"
                            Background="Transparent"
                            SnapsToDevicePixels="True">
                        <svgc:SvgViewbox Width="40"
                                           Height="40"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Stretch="Uniform"
                                           UriSource="pack://application:,,,/Resources/Images/header-navigation-user.svg" />
                    </Border>
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Montserrat}"
                               FontSize="{StaticResource Font.Size.SidebarBrand}"
                               FontWeight="ExtraBold"
                               Foreground="{DynamicResource Brush.Dashboard.AccentWarm}"
                               Text="INSTRUCTOR 2"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!--  Center: client 911 Reality wordmark (911-reality-logo.svg).  -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="640"
                        Height="64"
                        Background="Transparent">
                    <svgc:SvgViewbox HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Stretch="Uniform"
                                       UriSource="pack://application:,,,/Resources/Images/911-reality-logo.svg" />
                </Border>

                <!--  Right: SIMULATION (foreground) + READY (green) + clock.  -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Text.HeaderMeta}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Theme.Foreground}"
                               Text="SIMULATION" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.HeaderMeta}"
                               FontWeight="Bold"
                               Foreground="{StaticResource Brush.Status.Green}"
                               Text="READY" />
                    <TextBlock Margin="36,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Montserrat}"
                               FontSize="{StaticResource Font.Size.HeaderMeta}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource Brush.Theme.Foreground}"
                               Text="11:23 AM" />
                </StackPanel>
            </Grid>
        </ContentControl>

        <!--  Main: Folder View (scroll) + simulation footer below scroll area (not inside card scroll).  -->
        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Border Padding="28,24"
                        Background="{DynamicResource Brush.Dashboard.Panel}"
                        BorderBrush="{DynamicResource Brush.Theme.Border}"
                        BorderThickness="1"
                        CornerRadius="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Toolbar: title row; below — combined input bar with scope chips + path field.  -->
                        <Border Grid.Row="0"
                                Margin="0,0,0,18"
                                Padding="12,10"
                                Background="{DynamicResource Brush.Theme.Surface}"
                                BorderBrush="{DynamicResource Brush.Theme.Border}"
                                BorderThickness="1"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource Font.Montserrat}"
                                               FontSize="26"
                       FontWeight="Black"
                       Foreground="{DynamicResource Brush.Theme.Foreground}"
                                               Text="Folder View" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="Open Selected" Style="{StaticResource Dashboard.ToolbarPillPrimary}" />
                                        <Button Margin="12,0,0,0"
                                                Content="Change Path"
                                                Style="{StaticResource Dashboard.ToolbarPillOutline}" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1"
                                        Margin="0,12,0,0"
                                        MinHeight="44"
                                        Padding="6,4,10,4"
                                        Background="{DynamicResource Brush.Theme.Surface}"
                                        BorderBrush="{DynamicResource Brush.Theme.Border}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        SnapsToDevicePixels="True">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <RadioButton x:Name="FolderScopeInstructorChip"
                                                         Margin="0,0,8,0"
                                                         Content="Instructor"
                                                         GroupName="FolderScope"
                                                         Style="{StaticResource Dashboard.FolderScopeChip}" />
                                            <RadioButton Margin="0,0,8,0"
                                                         Content="Current Station"
                                                         GroupName="FolderScope"
                                                         Style="{StaticResource Dashboard.FolderScopeChip}" />
                                            <RadioButton Content="Direct Folder Access"
                                                         GroupName="FolderScope"
                                                         Style="{StaticResource Dashboard.FolderScopeChip}" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1"
                                                 MinHeight="36"
                                                 Margin="4,0,0,0"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="{StaticResource Font.Size.BodySmall}"
                                                 Foreground="{DynamicResource Brush.Theme.Foreground}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" MinHeight="320">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Available folders (reference: white card + pill header + rows).  -->
                            <Border Grid.Column="0"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Stretch"
                                    Padding="16,16"
                                    Background="{DynamicResource Brush.Theme.Surface}"
                                    BorderBrush="{DynamicResource Brush.Theme.Border}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    SnapsToDevicePixels="True">
                                <StackPanel>
                                    <Border HorizontalAlignment="Left"
                                            Margin="0,0,0,14"
                                            Height="32"
                                            Padding="14,0"
