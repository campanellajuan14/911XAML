<Window x:Class="NineOneOneReality.Launcher.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="9-1-1 Reality — Dashboard"
        Width="1280"
        Height="720"
        MinWidth="960"
        MinHeight="540"
        Background="{DynamicResource Brush.Theme.Background}"
        FontFamily="{StaticResource Font.Montserrat}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Theme.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="40">
        <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="32"
                       FontWeight="Black"
                       Foreground="{DynamicResource Brush.Theme.Foreground}"
                       Text="Dashboard" />
            <TextBlock Margin="0,16,0,0"
                       FontSize="16"
                       FontWeight="Medium"
                       Foreground="{DynamicResource Brush.Theme.Foreground.Muted}"
                       TextWrapping="Wrap"
                       Text="Secondary dashboard layout is part of the instructor workflow (client Fixes M4.pdf, page 5). This window is a structural placeholder so the Dashboard nav item opens a real surface — replace this content with the final folder / tiles design when art and spec are ready." />
        </StackPanel>
    </Grid>
</Window>
