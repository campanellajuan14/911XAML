<UserControl x:Class="NineOneOneReality.Launcher.Views.Inactive.InactiveScreenLightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <!--
        Light inactive monitor skin — matches client MAPPING reference:
        white field, thin inner frame, orange headline (#FF7A00), black ECG
        divider, then 9-1-1 (orange) + REALITY / SIMULATOR (black).
    -->
    <Viewbox x:Name="ArtHost"
             Stretch="Uniform"
             HorizontalAlignment="Left"
             VerticalAlignment="Top">
        <Grid Width="1366"
              Height="768"
              Background="#FFFFFFFF"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True">

            <Border Margin="28"
                    Background="#FFFFFFFF"
                    BorderBrush="#FFD0D0D0"
                    BorderThickness="1"
                    SnapsToDevicePixels="True" />

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="HeadlineText"
                           Margin="0,0,0,10"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource Font.Montserrat}"
                           FontSize="{StaticResource Font.Size.HeroTitle}"
                           FontWeight="Black"
                           Foreground="{StaticResource Brush.Brand.Orange}"
                           Text="VIEW STUDENT"
                           TextOptions.TextFormattingMode="Ideal"
                           TextOptions.TextRenderingMode="ClearType" />

                <Path Width="820"
                      Height="48"
                      Data="{StaticResource Icon.PulseLine}"
                      SnapsToDevicePixels="True"
                      Stretch="Fill"
                      Stroke="{DynamicResource Brush.Theme.Foreground}"
                      StrokeEndLineCap="Round"
                      StrokeStartLineCap="Round"
                      StrokeThickness="2.5"
                      UseLayoutRounding="True">
                    <Path.Effect>
                        <DropShadowEffect BlurRadius="6"
                                          Opacity="0.35"
                                          ShadowDepth="1"
                                          Direction="270"
                                          Color="#FF000000" />
                    </Path.Effect>
                </Path>

                <StackPanel Margin="0,10,0,0"
                            HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontFamily="{StaticResource Font.Montserrat}"
                               FontSize="{StaticResource Font.Size.Subtitle}"
                               FontWeight="Black"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="ClearType">
                        <Run Foreground="{StaticResource Brush.Brand.Orange}"
                             Text="9-1-1 " />
                        <Run Foreground="{DynamicResource Brush.Theme.Foreground}"
                             Text="REALITY" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center"
                               FontFamily="{StaticResource Font.Montserrat}"
                               FontSize="{StaticResource Font.Size.Subtitle}"
                               FontWeight="Black"
                               Foreground="{DynamicResource Brush.Theme.Foreground}"
                               Text="SIMULATOR"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="ClearType" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Viewbox>
</UserControl>
