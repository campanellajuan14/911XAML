<Window x:Class="NineOneOneReality.Launcher.Views.Inactive.InactiveStudentProcomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="9-1-1 Reality — PROCOM Student Inactive"
        Width="1920"
        Height="1080"
        MinWidth="1280"
        MinHeight="720"
        Background="{DynamicResource Brush.Theme.Background}"
        FontFamily="{StaticResource Font.Montserrat}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Theme.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ContentControl Grid.Row="0" Style="{StaticResource HeaderBarStyle}">
            <!--  Fixes M4.pdf: header is logo-only, centered. White mark when
                  `911-reality-logo-white.png` is supplied under Resources/Images.  -->
            <Image Height="58"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Source="/Resources/Images/911-reality-logo-white.png" />
        </ContentControl>

        <Grid Grid.Row="1" ClipToBounds="True">
            <!--  PROCOM inactive: brighter, sharper city map — 4K asset + scale.  -->
            <Image RenderOptions.BitmapScalingMode="HighQuality"
                   Source="/Resources/Images/citymap_dark_4k.png"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   RenderTransformOrigin="0.5,0.2">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.35" ScaleY="1.35" />
                </Image.RenderTransform>
            </Image>
        </Grid>
    </Grid>
</Window>
