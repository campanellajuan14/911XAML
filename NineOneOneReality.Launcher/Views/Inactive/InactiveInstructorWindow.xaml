<Window x:Class="NineOneOneReality.Launcher.Views.Inactive.InactiveInstructorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inactive="clr-namespace:NineOneOneReality.Launcher.Views.Inactive"
        Title="9-1-1 Reality — PLUS/BASIC Instructor Inactive"
        Background="#FF000000"
        FontFamily="{StaticResource Font.Montserrat}"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Theme.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <inactive:InactiveScreenView x:Name="Art"
                                 ArtBitmapScalingMode="HighQuality"
                                 ArtFileName="inactive-viewstudent-source.png" />
</Window>
