<Window x:Class="NineOneOneReality.Launcher.Views.Inactive.M4PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="9-1-1 Reality — Milestone 4 inactive monitors"
        Width="720"
        Height="520"
        MinWidth="520"
        MinHeight="420"
        Background="{DynamicResource Brush.Theme.Background}"
        FontFamily="{StaticResource Font.Montserrat}"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Theme.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Theme.Foreground}"
                       Text="Inactive monitor placeholders (M4)" />
            <TextBlock Margin="0,10,0,0"
                       FontSize="14"
                       FontWeight="Medium"
                       Foreground="{DynamicResource Brush.Theme.Foreground.Muted}"
                       TextWrapping="Wrap"
                       Text="Open each inactive monitor full-screen. The PNG already contains the full mock UI (titles, ECG, etc.) — only the app header and wordmark are overlaid in XAML. Swap Image Source in Views/Inactive/*.xaml when final art ships." />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,24,0,24"
                    VerticalAlignment="Center">
            <Button Margin="0,0,0,12"
                    HorizontalAlignment="Stretch"
                    Click="OnOpenInstructor"
                    Content="1 — Instructor inactive (PLUS/BASIC)"
                    Style="{StaticResource PrimaryButtonStyle}" />
            <Button Margin="0,0,0,12"
                    HorizontalAlignment="Stretch"
                    Click="OnOpenStudentBasic"
                    Content="2 — Student inactive (BASIC)"
                    Style="{StaticResource PrimaryButtonStyle}" />
            <Button HorizontalAlignment="Stretch"
                    Click="OnOpenStudentProcom"
                    Content="3 — Student inactive (PROCOM)"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   FontSize="12"
                   Foreground="{DynamicResource Brush.Theme.Foreground.Subtle}"
                   TextWrapping="Wrap"
                   Text="CLI: dotnet run -- --inactive=instructor | student-basic | student-procom" />
    </Grid>
</Window>
