<Window x:Class="NineOneOneReality.Launcher.Views.ActiveLightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:assist="clr-namespace:NineOneOneReality.Launcher"
        Title="9-1-1 Reality Simulator (Active - Light)"
        Width="1920"
        Height="1080"
        MinWidth="1280"
        MinHeight="720"
        Background="{DynamicResource Brush.Theme.Background}"
        FontFamily="{StaticResource Font.Montserrat}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <!--
        ACTIVE LIGHT SCREEN  (Milestone 3)
        ========================================================================
        Same layout and hero composition as the dark active screen, but merges
        Theme.Light.xaml at the Window level so every DynamicResource on
        Brush.Theme.* resolves to the light palette (sampled from the client's
        light instructor reference). Brand orange / green / START gradients stay
        on Brushes.Brand.xaml unchanged.

        Light-specific tuning in this file only: softer title ink shadow for
        dark text on a bright hero, slightly stronger orange grid lines, and
        the sidebar headset badge uses Theme.UserAvatar.Bg instead of a hard
        black chip.
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Theme.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Hairline divider used between sidebar sections.  -->
            <Style x:Key="Sidebar.Divider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="20,12,20,12" />
                <Setter Property="Background" Value="{DynamicResource Brush.Theme.Border.Subtle}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  =================================================================
              ROW 0 - HEADER BAR
              Client Fixes M4.pdf: no wordmark in the header strip — status +
              clock only.
              ================================================================= -->
        <ContentControl Grid.Row="0" Style="{StaticResource HeaderBarStyle}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Right: simulation status + clock  -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ContentControl Content="SIMULATION:"
                                    Style="{StaticResource StatusPill.Header}"
                                    Tag="READY" />
                    <TextBlock Margin="36,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Montserrat}"
                               FontSize="{StaticResource Font.Size.HeaderMeta}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource Brush.Theme.Foreground}"
                               Text="11:23 AM" />
                </StackPanel>
            </Grid>
        </ContentControl>

        <!--  =================================================================
              ROW 1 - SIDEBAR + HERO
              ================================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ========== SIDEBAR ==========
                  Rounded panel + colored Training/System icons (client reference).  -->
            <Border Grid.Column="0"
                    Background="Transparent"
                    Padding="10,10,8,10">
                <Border Background="{DynamicResource Brush.Theme.Sidebar}"
                        BorderBrush="{DynamicResource Brush.Theme.Sidebar.Frame}"
                        BorderThickness="1"
                        CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--  0  brand block (role identifier)  -->
                        <RowDefinition Height="Auto" />
                        <!--  1  divider  -->
                        <RowDefinition Height="Auto" />
                        <!--  2  primary nav  -->
                        <RowDefinition Height="Auto" />
                        <!--  3  divider  -->
                        <RowDefinition Height="Auto" />
                        <!--  4  TRAINING RESOURCES section  -->
                        <RowDefinition Height="*" />
                        <!--  5  spacer that pushes SYSTEM down  -->
                        <RowDefinition Height="Auto" />
                        <!--  6  divider  -->
                        <RowDefinition Height="Auto" />
                        <!--  7  SYSTEM section  -->
                        <RowDefinition Height="Auto" />
                        <!--  8  INSTRUCTOR footer  -->
                    </Grid.RowDefinitions>

                    <!--  0  Instructor strip: client 911-headset badge + “INSTRUCTOR 2”.  -->
                    <StackPanel Grid.Row="0" Margin="14,18,14,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42"
                                    Height="42"
                                    Background="#FF000000"
                                    CornerRadius="21"
                                    ClipToBounds="True"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16"
                                                      Opacity="0.55"
                                                      ShadowDepth="0"
                                                      Color="#FFFF7A00" />
                                </Border.Effect>
                                <Image Width="42"
                                       Height="42"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       SnapsToDevicePixels="True"
                                       Source="/Resources/Images/instructor-2-911-badge.png"
                                       Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Montserrat}"
                                       FontSize="{StaticResource Font.Size.SidebarBrand}"
                                       FontWeight="ExtraBold"
                                       Foreground="{StaticResource Brush.Brand.Orange}"
                                       Text="INSTRUCTOR 2"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <!--  1  divider  -->
                    <Border Grid.Row="1" Style="{StaticResource Sidebar.Divider}" />

                    <!--  2  Primary nav  -->
                    <StackPanel Grid.Row="2" Margin="0,4,0,4">
                        <RadioButton Content="Dashboard"
                                     Checked="OnDashboardNavChecked"
                                     Unchecked="OnDashboardNavUnchecked"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.Dashboard}" />
                        <RadioButton Content="Start Simulation"
                                     IsChecked="True"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.StartSimulation}" />
                        <RadioButton Content="User Manuals / IT Info"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.UserManuals}" />
                        <RadioButton Content="Video Tutorials"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.VideoTutorials}" />
                        <RadioButton Content="Listen To Recordings"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.ListenToRecordings}" />
                        <RadioButton Content="Settings"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.Settings}" />
                    </StackPanel>

                    <!--  3  divider  -->
                    <Border Grid.Row="3" Style="{StaticResource Sidebar.Divider}" />

                    <!--  4  Training resources section  -->
                    <StackPanel Grid.Row="4">
                        <TextBlock Margin="28,0,14,10"
                                   FontFamily="{StaticResource Font.Montserrat}"
                                   FontSize="{StaticResource Font.Size.NavSection}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Brand.Orange}"
                                   Text="TRAINING RESOURCES" />
                        <RadioButton GroupName="TrainingNav"
                                     assist:NavIconAssist.IdleFill="{StaticResource Brush.NavIcon.Layers}"
                                     Content="Welcome - Start Here"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.StartHere}" />
                        <RadioButton GroupName="TrainingNav"
                                     assist:NavIconAssist.IdleFill="{StaticResource Brush.NavIcon.Cube}"
                                     Content="9-1-1 Academy / AI"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.Academy}" />
                    </StackPanel>

                    <!--  6  divider (Row 5 is spacer)  -->
                    <Border Grid.Row="6" Style="{StaticResource Sidebar.Divider}" />

                    <!--  7  System section  -->
                    <StackPanel Grid.Row="7">
                        <TextBlock Margin="28,0,14,10"
                                   FontFamily="{StaticResource Font.Montserrat}"
                                   FontSize="{StaticResource Font.Size.NavSection}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Brand.Orange}"
                                   Text="SYSTEM" />
                        <RadioButton GroupName="SystemNav"
                                     assist:NavIconAssist.IdleFill="{StaticResource Brush.NavIcon.Restart}"
                                     Content="Restart"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.Restart}" />
                        <RadioButton GroupName="SystemNav"
                                     assist:NavIconAssist.IdleFill="{StaticResource Brush.NavIcon.Shutdown}"
                                     Content="Shutdown"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.Shutdown}" />
                    </StackPanel>

                    <!--  8  INSTRUCTOR role chip (client reference).  -->
                    <Border Grid.Row="8"
                            Margin="14,16,14,18"
                            Padding="12,10"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Brush.Theme.Border}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Path Width="22"
                                  Height="22"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource Icon.UserAvatar.Outline}"
                                  Fill="{DynamicResource Brush.Theme.Foreground}"
                                  Stretch="Uniform" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Montserrat}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Theme.Foreground}"
                                       Text="INSTRUCTOR" />
                        </StackPanel>
                    </Border>
                </Grid>
                </Border>
            </Border>

            <!--  ========== HERO PANEL ==========
                  Cinematic-depth layer order (bottom to top):
                    L1   dark base                       (Window background)
                    L2   tiled vector grid               (DrawingBrush, subtle)
                    L3   warm horizon glow at the bottom (suggests city lights)
                    L4   diagonal atmospheric haze       (top-left -> bottom-right)
                    L5   cityscape silhouette PLACEHOLDER  (reserved slot for
                                                            artist's PNG)
                    L6   multi-stop radial spotlight     (warm halo behind logo)
                    L7   scanline overlay                (per City Scape doc)
                    L8   vignette                        (legibility frame)
                    L9   top orange separator stripe     (continues from header)
                    L10  hero content stack              (white wordmark, ECG,
                                                          button, status)
                  ============================================================ -->
            <Grid Grid.Column="1" ClipToBounds="True">

                <!--  L2  vector grid texture  -->
                <Rectangle>
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile"
                                      Viewport="0,0,56,56"
                                      ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#55FF7A00" Thickness="0.55" />
                                    </GeometryDrawing.Pen>
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="0,0" EndPoint="56,0" />
                                            <LineGeometry StartPoint="0,0" EndPoint="0,56" />
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!--  L3  warm horizon glow at the bottom edge - the cinematic
                      "city lights below" feel without needing the artwork.  -->
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Offset="0.00" Color="#00000000" />
                            <GradientStop Offset="0.62" Color="#00000000" />
                            <GradientStop Offset="0.85" Color="#22FF7A00" />
                            <GradientStop Offset="1.00" Color="#44FF6600" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!--  L4  diagonal atmospheric haze  -->
                <Rectangle IsHitTestVisible="False" Opacity="0.6">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.00" Color="#10FF9A40" />
                            <GradientStop Offset="0.50" Color="#00000000" />
                            <GradientStop Offset="1.00" Color="#15FF6600" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!--  L5  cityscape background.
                      Artist-supplied dark-base + orange-road-glow PNG. Stretched
                      to fill the hero pane edge-to-edge and held at low opacity
                      so it sits behind the dashboard UI without competing with
                      the title, ECG, or START button. A vertical soft mask
                      fades the top and bottom edges so the image blends into
                      the dark base instead of cutting hard.

                      File: Resources/Images/citymap_dark_4k.png
                      (Awaiting 3840 x 2160 re-export from client's artist;
                       the current 1002 x 558 source renders fine on 1080p and
                       will get sharper automatically when the higher-res file
                       drops into the same path.)  -->
                <Image IsHitTestVisible="False"
                       Opacity="0.36"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="/Resources/Images/citymap_dark_4k.png"
                       Stretch="UniformToFill">
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.00" Color="#00000000" />
                            <GradientStop Offset="0.18" Color="#FF000000" />
                            <GradientStop Offset="0.82" Color="#FF000000" />
                            <GradientStop Offset="1.00" Color="#00000000" />
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>

                <!--  L6  multi-stop radial spotlight behind the hero stack.
                      Three stops give a softer falloff than the prototype's
                      two-stop version - this is the main "depth" contribution.  -->
                <Ellipse Width="1200"
                         Height="780"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.5,0.45">
                            <GradientStop Offset="0.00" Color="#3DFF7A00" />
                            <GradientStop Offset="0.30" Color="#22FF7A00" />
                            <GradientStop Offset="0.65" Color="#0AFF7A00" />
                            <GradientStop Offset="1.00" Color="#00000000" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!--  L7  scanline overlay - very subtle 1px horizontal lines
                      every 3px, mimicking the optional pattern called out in
                      City Scape for all.odt.  -->
                <Rectangle IsHitTestVisible="False" Opacity="0.20">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile"
                                      Viewport="0,0,1,3"
                                      ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="#08FF7A00"
                                                 Geometry="M 0,0 H 1 V 1 H 0 Z" />
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!--  L8  vignette  -->
                <Rectangle Fill="{DynamicResource Brush.Theme.HeroVignette}"
                           IsHitTestVisible="False" />

                <!--  L9  full-bleed orange separator from header continues  -->
                <Rectangle Height="1"
                           VerticalAlignment="Top"
                           Fill="{StaticResource Brush.Brand.Orange}"
                           Opacity="0.6" />

                <!--  L10  hero content (vertically centered stack)  -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!--  Centered white wordmark (rasterized from client 911 reality.svg).  -->
                    <Grid Width="760"
                          Height="300"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,4">
                        <Ellipse Width="720"
                                 Height="260"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0.00" Color="#55FF7A00" />
                                    <GradientStop Offset="0.60" Color="#15FF7A00" />
                                    <GradientStop Offset="1.00" Color="#00000000" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Image MaxWidth="700"
                               MaxHeight="280"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="/Resources/Images/911-reality-logo-hero-white.png"
                               Stretch="Uniform">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="22"
                                                  Opacity="0.55"
                                                  ShadowDepth="0"
                                                  Color="#FFFF7A00" />
                            </Image.Effect>
                        </Image>
                    </Grid>

                    <!--  ECG pulse line - wider + stronger bloom  -->
                    <Path x:Name="EcgPulseLine"
                          Width="620"
                          Height="36"
                          Margin="0,18,0,0"
                          HorizontalAlignment="Center"
                          Data="{StaticResource Icon.PulseLine}"
                          Stretch="Fill"
                          Stroke="{StaticResource Brush.Brand.Orange}"
                          StrokeEndLineCap="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="3">
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              Opacity="0.95"
                                              ShadowDepth="0"
                                              Color="#FFFF6A00" />
                        </Path.Effect>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.55"
                                                         To="1.00"
                                                         Duration="0:0:1.20">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>

                    <!--  START SIMULATION label  -->
                    <TextBlock Margin="0,16,0,8"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource Font.Montserrat}"
                               FontSize="{StaticResource Font.Size.SectionLabel}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Theme.Foreground}"
                               Text="START SIMULATION" />

                    <!--  START button with floor-glow underneath  -->
                    <Grid HorizontalAlignment="Center">
                        <Ellipse Width="320"
                                 Height="50"
                                 Margin="0,40,0,0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0.00" Color="#88FF7A00" />
                                    <GradientStop Offset="1.00" Color="#00000000" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Button Content="START" Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>

                    <!--  System status row  -->
                    <ContentControl Margin="0,20,0,4"
                                    Content="SYSTEM STATUS:"
                                    Style="{StaticResource StatusPill.System}"
                                    Tag="READY" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
