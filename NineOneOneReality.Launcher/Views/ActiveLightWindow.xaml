<Window x:Class="NineOneOneReality.Launcher.Views.ActiveLightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:assist="clr-namespace:NineOneOneReality.Launcher"
        Title="9-1-1 Reality Simulator (Active - Light)"
        Width="1920"
        Height="1080"
        MinWidth="1280"
        MinHeight="720"
        Background="{DynamicResource Brush.Theme.Background}"
        FontFamily="{StaticResource Font.Montserrat}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <!--
        ACTIVE LIGHT SCREEN  (Milestone 3)
        ========================================================================
        Same layout and hero composition as the dark active screen, but merges
        Theme.Light.xaml at the Window level so every DynamicResource on
        Brush.Theme.* resolves to the light palette (sampled from the client's
        light instructor reference). Brand orange / green / START gradients stay
        on Brushes.Brand.xaml unchanged.

        Light-specific tuning in this file only: perspective-grid cityscape hero
        (citymap_light_4k.png), colored client wordmark at hero scale,
        and the sidebar headset badge uses Theme.UserAvatar.Bg instead of a hard
        black chip.
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Theme.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Hairline divider used between sidebar sections.  -->
            <Style x:Key="Sidebar.Divider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="20,12,20,12" />
                <Setter Property="Background" Value="{DynamicResource Brush.Theme.Border.Subtle}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="7" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ========== SIDEBAR (inset from window edges; inner chrome unchanged).  ========== -->
            <Border Grid.Row="0"
                    Grid.RowSpan="3"
                    Grid.Column="0"
                    Background="Transparent"
                    Margin="14,14,12,14"
                    Padding="0">
                <Border Background="{DynamicResource Brush.Theme.Sidebar}"
                        BorderBrush="{DynamicResource Brush.Theme.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="14,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--  0  brand block (role identifier)  -->
                        <RowDefinition Height="Auto" />
                        <!--  1  primary nav  -->
                        <RowDefinition Height="Auto" />
                        <!--  2  divider  -->
                        <RowDefinition Height="Auto" />
                        <!--  3  TRAINING RESOURCES section  -->
                        <RowDefinition Height="*" />
                        <!--  4  spacer that pushes SYSTEM down  -->
                        <RowDefinition Height="Auto" />
                        <!--  5  divider  -->
                        <RowDefinition Height="Auto" />
                        <!--  6  SYSTEM section  -->
                        <RowDefinition Height="Auto" />
                        <!--  7  INSTRUCTOR footer  -->
                    </Grid.RowDefinitions>

                    <!--  0  Instructor strip: client 911-headset badge + “INSTRUCTOR 2”.  -->
                    <StackPanel Grid.Row="0" Margin="14,18,14,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42"
                                    Height="42"
                                    Background="{DynamicResource Brush.Theme.Sidebar}"
                                    CornerRadius="21"
                                    ClipToBounds="True"
                                    SnapsToDevicePixels="True">
                                <!--  Sidebar-tinted disc behind PNG so light mode matches panel (no black halo).  -->
                                <Image Width="42"
                                       Height="42"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       SnapsToDevicePixels="True"
                                       Source="/Resources/Images/SidebarNav/instructor-sidebar-badge.png"
                                       Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Montserrat}"
                                       FontSize="{StaticResource Font.Size.SidebarBrand}"
                                       FontWeight="ExtraBold"
                                       Foreground="{StaticResource Brush.Brand.Orange}"
                                       Text="INSTRUCTOR 2"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <!--  1  Primary nav  -->
                    <StackPanel Grid.Row="1" Margin="0,4,0,4">
                        <RadioButton Content="Dashboard"
                                     assist:NavIconAssist.SvgIcon="pack://application:,,,/Resources/Images/SidebarNav/dashboard.svg"
                                     Checked="OnDashboardNavChecked"
                                     Unchecked="OnDashboardNavUnchecked"
                                     Style="{StaticResource NavButtonStyle}" />
                        <RadioButton Content="Start Simulation"
                                     assist:NavIconAssist.SvgIcon="pack://application:,,,/Resources/Images/SidebarNav/start-simulation.svg"
                                     IsChecked="True"
                                     Style="{StaticResource NavButtonStyle}" />
                        <RadioButton assist:NavIconAssist.SvgIcon="pack://application:,,,/Resources/Images/SidebarNav/user-manuals.svg"
                                     Content="User Manuals / IT Info"
                                     Style="{StaticResource NavButtonStyle}" />
                        <RadioButton assist:NavIconAssist.SvgIcon="pack://application:,,,/Resources/Images/SidebarNav/video-tutorials.svg"
                                     Content="Video Tutorials"
                                     Style="{StaticResource NavButtonStyle}" />
                        <RadioButton assist:NavIconAssist.SvgIcon="pack://application:,,,/Resources/Images/SidebarNav/listen-to-recording.svg"
                                     Content="Listen To Recordings"
                                     Style="{StaticResource NavButtonStyle}" />
                        <RadioButton Content="Settings"
                                     assist:NavIconAssist.SvgIcon="pack://application:,,,/Resources/Images/SidebarNav/settings.svg"
                                     Style="{StaticResource NavButtonStyle}" />
                    </StackPanel>

                    <!--  2  divider  -->
                    <Border Grid.Row="2" Style="{StaticResource Sidebar.Divider}" />

                    <!--  3  Training resources section  -->
                    <StackPanel Grid.Row="3">
                        <TextBlock Margin="28,0,14,10"
                                   FontFamily="{StaticResource Font.Montserrat}"
                                   FontSize="{StaticResource Font.Size.NavSection}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Brand.Orange}"
                                   Text="TRAINING RESOURCES" />
                        <RadioButton GroupName="TrainingNav"
                                     assist:NavIconAssist.SvgIcon="pack://application:,,,/Resources/Images/SidebarNav/welcome.svg"
                                     Content="Welcome - Start Here"
                                     Style="{StaticResource NavButtonStyle}" />
                        <RadioButton GroupName="TrainingNav"
                                     assist:NavIconAssist.SvgIcon="pack://application:,,,/Resources/Images/SidebarNav/academy-911.svg"
                                     Content="9-1-1 Academy / AI"
                                     Style="{StaticResource NavButtonStyle}" />
                    </StackPanel>

                    <!--  5  divider (Row 4 is spacer)  -->
                    <Border Grid.Row="5" Style="{StaticResource Sidebar.Divider}" />

                    <!--  6  System section  -->
                    <StackPanel Grid.Row="6">
                        <TextBlock Margin="28,0,14,10"
                                   FontFamily="{StaticResource Font.Montserrat}"
                                   FontSize="{StaticResource Font.Size.NavSection}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Brand.Orange}"
                                   Text="SYSTEM" />
                        <RadioButton GroupName="SystemNav"
                                     assist:NavIconAssist.IdleFill="{StaticResource Brush.NavIcon.Restart}"
                                     Content="Restart"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.Restart}" />
                        <RadioButton GroupName="SystemNav"
                                     assist:NavIconAssist.IdleFill="{StaticResource Brush.NavIcon.Shutdown}"
                                     Content="Shutdown"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.Shutdown}" />
                    </StackPanel>

                    <!--  7  INSTRUCTOR role chip (client reference).  -->
                    <Border Grid.Row="7"
                            Margin="14,16,14,18"
                            Padding="12,10"
                            Background="{DynamicResource Brush.Theme.Surface}"
                            BorderBrush="{DynamicResource Brush.Theme.Border}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid Grid.IsSharedSizeScope="True"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="InstructorChipBalance" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="InstructorChipBalance" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0"
                                     Width="30"
                                     Height="30"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     SnapsToDevicePixels="True"
                                     UseLayoutRounding="True">
                                <Canvas Width="24"
                                        Height="24"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <Ellipse Canvas.Left="2"
                                             Canvas.Top="2"
                                             Width="20"
                                             Height="20"
                                             Fill="Transparent"
                                             Stroke="{DynamicResource Brush.Theme.Foreground}"
                                             StrokeThickness="1.35" />
                                    <Ellipse Canvas.Left="8"
                                             Canvas.Top="6"
                                             Width="8"
                                             Height="8"
                                             Fill="Transparent"
                                             Stroke="{DynamicResource Brush.Theme.Foreground}"
                                             StrokeThickness="1.35"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Top" />
                                    <Path Data="M5.75,17.75 Q12,13.75 18.25,17.75"
                                          Fill="Transparent"
                                          Stroke="{DynamicResource Brush.Theme.Foreground}"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.35" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Montserrat}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Theme.Foreground}"
                                       Text="INSTRUCTOR" />
                            <Border Grid.Column="2"
                                    Background="Transparent" />
                        </Grid>
                    </Border>
                </Grid>
                </Border>
            </Border>

        <!--  =================================================================
              HEADER (column 1): brand left + status / clock right.
              ================================================================= -->
        <ContentControl Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource HeaderBarStyle.Active}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Brand: headset-in-circle, no mic (native shapes).  -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Viewbox Width="40"
                             Height="40"
                             SnapsToDevicePixels="True"
                             Stretch="Uniform"
                             UseLayoutRounding="True">
                        <Canvas Width="48" Height="48" SnapsToDevicePixels="True">
                            <Ellipse Canvas.Left="3"
                                     Canvas.Top="3"
                                     Width="42"
                                     Height="42"
                                     Fill="Transparent"
                                     Stroke="{StaticResource Brush.Brand.Orange}"
                                     StrokeThickness="2" />
                            <Path Data="M 12.5,19.5 A 11.5,11.5 0 0 1 35.5,19.5"
                                  Fill="Transparent"
                                  Stroke="{StaticResource Brush.Brand.Orange}"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="2" />
                            <Path Data="M 15,36 C 17,32 20,30 24,30 S 31,32 33,36"
                                  Fill="Transparent"
                                  Stroke="{StaticResource Brush.Brand.Orange}"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="2.35" />
                            <Ellipse Canvas.Left="16.5"
                                     Canvas.Top="11.5"
                                     Width="15"
                                     Height="15"
                                     Fill="{StaticResource Brush.Brand.Orange}" />
                            <Rectangle Canvas.Left="5.5"
                                       Canvas.Top="15.5"
                                       Width="5.5"
                                       Height="12.5"
                                       RadiusX="1.2"
                                       RadiusY="1.2"
                                       Fill="{StaticResource Brush.Brand.Orange}" />
                            <Rectangle Canvas.Left="37"
                                       Canvas.Top="15.5"
                                       Width="5.5"
                                       Height="12.5"
                                       RadiusX="1.2"
                                       RadiusY="1.2"
                                       Fill="{StaticResource Brush.Brand.Orange}" />
                        </Canvas>
                    </Viewbox>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource Font.Montserrat}"
                                   FontSize="{StaticResource Font.Size.HeaderBrand}"
                                   FontWeight="ExtraBold">
                            <Run Foreground="{StaticResource Brush.Brand.Header911}"
                                 Text="911" />
                            <Run Foreground="{DynamicResource Brush.Theme.Foreground}"
                                 Text=" REALITY SIMULATOR" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ContentControl Content="SIMULATION:"
                                    Style="{StaticResource StatusPill.Header}"
                                    Tag="READY" />
                    <TextBlock Margin="36,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Montserrat}"
                               FontSize="{StaticResource Font.Size.HeaderMeta}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource Brush.Theme.Foreground}"
                               Text="11:23 AM" />
                </StackPanel>
            </Grid>
        </ContentControl>

        <!--  Under-header glow: lighter warm ramp (Brush.Header.UnderGlow).  -->
        <Grid Grid.Row="1"
              Grid.Column="1"
              Height="7"
              VerticalAlignment="Stretch"
              IsHitTestVisible="False">
            <Rectangle VerticalAlignment="Stretch"
                       Fill="{StaticResource Brush.Header.UnderGlow}"
                       Opacity="0.62">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Offset="0.00" Color="#00000000" />
                        <GradientStop Offset="0.22" Color="#6FFFFFFF" />
                        <GradientStop Offset="0.50" Color="#FFFFFFFF" />
                        <GradientStop Offset="0.78" Color="#6FFFFFFF" />
                        <GradientStop Offset="1.00" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="2"
                       VerticalAlignment="Center"
                       Fill="{StaticResource Brush.Header.UnderGlow}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Offset="0.00" Color="#00000000" />
                        <GradientStop Offset="0.28" Color="#D0FFFFFF" />
                        <GradientStop Offset="0.50" Color="#FFFFFFFF" />
                        <GradientStop Offset="0.72" Color="#D0FFFFFF" />
                        <GradientStop Offset="1.00" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>

            <!--  ========== HERO PANEL (light: perspective-grid cityscape)  ========== -->
            <Grid Grid.Row="2"
                  Grid.Column="1"
                  Background="{DynamicResource Brush.Theme.Background}"
                  ClipToBounds="False">

                <!--  Light cityscape background — artist perspective grid on white.
                      File: Resources/Images/citymap_light_4k.png
                      (Replace this file to upgrade resolution; same path,
                       no XAML changes required.)  -->
                <Image IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="/Resources/Images/citymap_light_4k.png"
                       Stretch="UniformToFill" />

                <!--  Soft white vignette so hero chrome stays legible on the grid.  -->
                <Rectangle Fill="{DynamicResource Brush.Theme.HeroVignette}"
                           IsHitTestVisible="False"
                           Opacity="0.28" />

                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="18" />
                        </StackPanel.RenderTransform>

                    <!--  Centered wordmark at hero scale (first correction); no halo/shadow.  -->
                    <Grid Width="1200"
                          Height="440"
                          HorizontalAlignment="Center">
                        <Image MaxWidth="1140"
                               MaxHeight="440"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="/Resources/Images/911-reality-logo.png"
                               Stretch="Uniform" />
                    </Grid>

                    <!--  Start block: pulled up toward wordmark (layout margin, not render-only transform).  -->
                    <StackPanel Margin="0,-86,0,0">
                    <Path x:Name="EcgPulseLine"
                          Width="760"
                          Height="72"
                          Margin="0,0,0,6"
                          HorizontalAlignment="Center"
                          Data="{StaticResource Icon.PulseLine}"
                          SnapsToDevicePixels="True"
                          Stretch="Fill"
                          Stroke="{StaticResource Brush.Hero.EcgPulseStroke}"
                          StrokeEndLineCap="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="2.5"
                          UseLayoutRounding="True" />

                    <TextBlock Margin="0,0,0,8"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource Font.Montserrat}"
                               FontSize="{StaticResource Font.Size.SectionLabel}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Theme.Foreground}"
                               Text="START SIMULATION" />

                    <Grid HorizontalAlignment="Center">
                        <Ellipse Width="320"
                                 Height="50"
                                 Margin="0,40,0,0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0.00" Color="#88FF7A00" />
                                    <GradientStop Offset="1.00" Color="#00000000" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Button Content="START" Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>

                    <ContentControl Margin="0,10,0,18"
                                    Content="SYSTEM STATUS:"
                                    Style="{StaticResource StatusPill.System}"
                                    Tag="READY" />
                    </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
    </Grid>
</Window>
