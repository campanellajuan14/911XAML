<Window x:Class="NineOneOneReality.Launcher.Views.ActiveDarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="9-1-1 Reality Simulator (Active - Dark)"
        Width="1920"
        Height="1080"
        MinWidth="1280"
        MinHeight="720"
        Background="{DynamicResource Brush.Theme.Background}"
        FontFamily="{StaticResource Font.Montserrat}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <!--
        ACTIVE DARK SCREEN  (M1 - Alignment Proof)
        ========================================================================
        Implements the four polish directions requested by the client after
        the prototype review:

          1. Cinematic depth   - layered atmospheric backgrounds (warm horizon,
                                  diagonal haze, scanline overlay, multi-stop
                                  radial spotlight). Reserved slot for the
                                  artist's `cityscape-active-source.png` master.
          2. Glow layering     - multi-pass DropShadowEffects on the title, an
                                  orange halo behind the wordmark, intensified
                                  ECG bloom, floor-glow under the START button.
          3. Sidebar spacing   - hairline dividers between sections, taller
                                  nav rows for breathing room, polished
                                  ENTER MODEL pill.
          4. Hero scale        - wordmark logo where the placeholder badge was,
                                  rebalanced title sizes, wider ECG, tightened
                                  vertical rhythm.

        Theme architecture unchanged: Theme.Dark.xaml is merged at the Window
        level so a parallel Light window can swap it for Theme.Light.xaml and
        share every other dictionary unchanged.
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Theme.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Free-form model input pill (sidebar bottom).  -->
            <Style x:Key="ModelInputBox" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource Font.Montserrat}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Theme.Foreground}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="CaretBrush" Value="{StaticResource Brush.Brand.Orange}" />
                <Setter Property="SelectionBrush" Value="{StaticResource Brush.Brand.Orange}" />
                <Setter Property="MaxLength" Value="22" />
                <Setter Property="CharacterCasing" Value="Upper" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          Background="Transparent"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  Hairline divider used between sidebar sections.  -->
            <Style x:Key="Sidebar.Divider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="20,12,20,12" />
                <Setter Property="Background" Value="{DynamicResource Brush.Theme.Border.Subtle}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <!--  Stacked-glow effect for the giant hero title (warm outer halo +
                  inner shadow used together via a single DropShadowEffect with
                  large blur radius and high opacity; a second pass is impossible
                  in XAML without nesting in a VisualBrush, so we keep one strong
                  glow here and let the cinematic background carry the rest).  -->
            <DropShadowEffect x:Key="Effect.HeroTitleGlow"
                              BlurRadius="32"
                              Opacity="0.55"
                              ShadowDepth="0"
                              Color="#FFFF7A00" />

            <DropShadowEffect x:Key="Effect.HeroTitleInk"
                              BlurRadius="8"
                              Opacity="0.85"
                              ShadowDepth="0"
                              Color="#FF000000" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  =================================================================
              ROW 0 - HEADER BAR
              The wordmark logo (Resources/Images/911-reality-logo.png) sits on
              the left, the role badge "INSTRUCTOR 2" is in the sidebar top
              (per the SOW: "Identification of the role by computer name"),
              right side carries SIMULATION status and clock.
              ================================================================= -->
        <ContentControl Grid.Row="0" Style="{StaticResource HeaderBarStyle}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Left: brand wordmark  -->
                <Image Grid.Column="0"
                       Height="52"
                       Margin="20,0,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="/Resources/Images/911-reality-logo.png" />

                <!--  Right: simulation status + clock  -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ContentControl Content="SIMULATION:"
                                    Style="{StaticResource StatusPill.Header}"
                                    Tag="READY" />
                    <TextBlock Margin="36,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Montserrat}"
                               FontSize="{StaticResource Font.Size.HeaderMeta}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource Brush.Theme.Foreground}"
                               Text="11:23 AM" />
                </StackPanel>
            </Grid>
        </ContentControl>

        <!--  =================================================================
              ROW 1 - SIDEBAR + HERO
              ================================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ========== SIDEBAR ==========
                  Polished spacing: hairline dividers between sections so the
                  visual rhythm is brand / primary nav / training / system /
                  model input - five distinct zones instead of one long list.  -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.Theme.Sidebar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--  0  brand block (role identifier)  -->
                        <RowDefinition Height="Auto" />
                        <!--  1  divider  -->
                        <RowDefinition Height="Auto" />
                        <!--  2  primary nav  -->
                        <RowDefinition Height="Auto" />
                        <!--  3  divider  -->
                        <RowDefinition Height="Auto" />
                        <!--  4  TRAINING RESOURCES section  -->
                        <RowDefinition Height="*" />
                        <!--  5  spacer that pushes SYSTEM down  -->
                        <RowDefinition Height="Auto" />
                        <!--  6  divider  -->
                        <RowDefinition Height="Auto" />
                        <!--  7  SYSTEM section  -->
                        <RowDefinition Height="Auto" />
                        <!--  8  model input footer  -->
                    </Grid.RowDefinitions>

                    <!--  0  Brand / role identifier  -->
                    <StackPanel Grid.Row="0" Margin="14,18,14,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42"
                                    Height="42"
                                    Background="#FF1A1A1A"
                                    CornerRadius="21">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16"
                                                      Opacity="0.55"
                                                      ShadowDepth="0"
                                                      Color="#FFFF7A00" />
                                </Border.Effect>
                                <Path Width="26"
                                      Height="26"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource Icon.HeadsetBadge}"
                                      Fill="{StaticResource Brush.Brand.Orange}"
                                      Stretch="Uniform" />
                            </Border>
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Montserrat}"
                                       FontSize="{StaticResource Font.Size.SidebarBrand}"
                                       FontWeight="ExtraBold"
                                       Foreground="{StaticResource Brush.Brand.Orange}"
                                       Text="INSTRUCTOR 2"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <!--  1  divider  -->
                    <Border Grid.Row="1" Style="{StaticResource Sidebar.Divider}" />

                    <!--  2  Primary nav  -->
                    <StackPanel Grid.Row="2" Margin="0,4,0,4">
                        <RadioButton Content="Dashboard"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.Dashboard}" />
                        <RadioButton Content="Start Simulation"
                                     IsChecked="True"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.StartSimulation}" />
                        <RadioButton Content="User Manuals / IT Info"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.UserManuals}" />
                        <RadioButton Content="Video Tutorials"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.VideoTutorials}" />
                        <RadioButton Content="Listen To Recordings"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.ListenToRecordings}" />
                        <RadioButton Content="Settings"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.Settings}" />
                    </StackPanel>

                    <!--  3  divider  -->
                    <Border Grid.Row="3" Style="{StaticResource Sidebar.Divider}" />

                    <!--  4  Training resources section  -->
                    <StackPanel Grid.Row="4">
                        <TextBlock Margin="28,0,14,10"
                                   FontFamily="{StaticResource Font.Montserrat}"
                                   FontSize="{StaticResource Font.Size.NavSection}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Brand.Orange}"
                                   Text="TRAINING RESOURCES" />
                        <RadioButton GroupName="TrainingNav"
                                     Content="Welcome - Start Here"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.StartHere}" />
                        <RadioButton GroupName="TrainingNav"
                                     Content="9-1-1 Academy / AI"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.Academy}" />
                    </StackPanel>

                    <!--  6  divider (Row 5 is spacer)  -->
                    <Border Grid.Row="6" Style="{StaticResource Sidebar.Divider}" />

                    <!--  7  System section  -->
                    <StackPanel Grid.Row="7">
                        <TextBlock Margin="28,0,14,10"
                                   FontFamily="{StaticResource Font.Montserrat}"
                                   FontSize="{StaticResource Font.Size.NavSection}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Brand.Orange}"
                                   Text="SYSTEM" />
                        <RadioButton GroupName="SystemNav"
                                     Content="Restart"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.Restart}" />
                        <RadioButton GroupName="SystemNav"
                                     Content="Shutdown"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.Shutdown}" />
                    </StackPanel>

                    <!--  8  Lower model label - free-form input.  -->
                    <Border Grid.Row="8"
                            Margin="14,16,14,18"
                            Padding="14,11"
                            BorderBrush="{DynamicResource Brush.Theme.Border}"
                            BorderThickness="1"
                            CornerRadius="999">
                        <Grid>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Montserrat}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Theme.Foreground.Muted}"
                                       IsHitTestVisible="False"
                                       Text="ENTER MODEL">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ModelInputBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="ModelInputBox"
                                     Style="{StaticResource ModelInputBox}"
                                     ToolTip="Enter your simulator model (e.g. BASIC, PLUS, PROCOMM)" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!--  ========== HERO PANEL ==========
                  Cinematic-depth layer order (bottom to top):
                    L1   dark base                       (Window background)
                    L2   tiled vector grid               (DrawingBrush, subtle)
                    L3   warm horizon glow at the bottom (suggests city lights)
                    L4   diagonal atmospheric haze       (top-left -> bottom-right)
                    L5   cityscape silhouette PLACEHOLDER  (reserved slot for
                                                            artist's PNG)
                    L6   multi-stop radial spotlight     (warm halo behind logo)
                    L7   scanline overlay                (per City Scape doc)
                    L8   vignette                        (legibility frame)
                    L9   top orange separator stripe     (continues from header)
                    L10  hero content stack              (wordmark, title, ECG,
                                                          button, status)
                  ============================================================ -->
            <Grid Grid.Column="1" ClipToBounds="True">

                <!--  L2  vector grid texture  -->
                <Rectangle>
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile"
                                      Viewport="0,0,56,56"
                                      ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#1FFF7A00" Thickness="0.5" />
                                    </GeometryDrawing.Pen>
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="0,0" EndPoint="56,0" />
                                            <LineGeometry StartPoint="0,0" EndPoint="0,56" />
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!--  L3  warm horizon glow at the bottom edge - the cinematic
                      "city lights below" feel without needing the artwork.  -->
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Offset="0.00" Color="#00000000" />
                            <GradientStop Offset="0.62" Color="#00000000" />
                            <GradientStop Offset="0.85" Color="#22FF7A00" />
                            <GradientStop Offset="1.00" Color="#44FF6600" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!--  L4  diagonal atmospheric haze  -->
                <Rectangle IsHitTestVisible="False" Opacity="0.6">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.00" Color="#10FF9A40" />
                            <GradientStop Offset="0.50" Color="#00000000" />
                            <GradientStop Offset="1.00" Color="#15FF6600" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!--  L5  cityscape silhouette PLACEHOLDER.
                      When the artist supplies a transparent PNG that contains
                      ONLY the city skyline / orange-road glow (no UI, no text),
                      set Source below and uncomment.

                <Image Source="/Resources/Images/citymap_dark_4k.png"
                       Stretch="UniformToFill"
                       Height="520"
                       VerticalAlignment="Center"
                       Opacity="0.35"
                       IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.00" Color="#00000000" />
                            <GradientStop Offset="0.25" Color="#FF000000" />
                            <GradientStop Offset="0.75" Color="#FF000000" />
                            <GradientStop Offset="1.00" Color="#00000000" />
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>
                -->

                <!--  L6  multi-stop radial spotlight behind the hero stack.
                      Three stops give a softer falloff than the prototype's
                      two-stop version - this is the main "depth" contribution.  -->
                <Ellipse Width="1200"
                         Height="780"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.5,0.45">
                            <GradientStop Offset="0.00" Color="#3DFF7A00" />
                            <GradientStop Offset="0.30" Color="#22FF7A00" />
                            <GradientStop Offset="0.65" Color="#0AFF7A00" />
                            <GradientStop Offset="1.00" Color="#00000000" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!--  L7  scanline overlay - very subtle 1px horizontal lines
                      every 3px, mimicking the optional pattern called out in
                      City Scape for all.odt.  -->
                <Rectangle IsHitTestVisible="False" Opacity="0.20">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile"
                                      Viewport="0,0,1,3"
                                      ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="#08FF7A00"
                                                 Geometry="M 0,0 H 1 V 1 H 0 Z" />
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!--  L8  vignette  -->
                <Rectangle Fill="{DynamicResource Brush.Theme.HeroVignette}"
                           IsHitTestVisible="False" />

                <!--  L9  full-bleed orange separator from header continues  -->
                <Rectangle Height="1"
                           VerticalAlignment="Top"
                           Fill="{StaticResource Brush.Brand.Orange}"
                           Opacity="0.6" />

                <!--  L10  hero content (vertically centered stack)  -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!--  Wordmark logo with orange halo behind  -->
                    <Grid Width="560" Height="220" HorizontalAlignment="Center">
                        <Ellipse Width="540"
                                 Height="200"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0.00" Color="#55FF7A00" />
                                    <GradientStop Offset="0.60" Color="#15FF7A00" />
                                    <GradientStop Offset="1.00" Color="#00000000" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Image HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="/Resources/Images/911-reality-logo.png"
                               Stretch="Uniform">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="22"
                                                  Opacity="0.55"
                                                  ShadowDepth="0"
                                                  Color="#FFFF7A00" />
                            </Image.Effect>
                        </Image>
                    </Grid>

                    <!--  Hero title - rebalanced sizes + multi-pass glow  -->
                    <Grid Margin="0,8,0,0" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   HorizontalAlignment="Center"
                                   Effect="{StaticResource Effect.HeroTitleGlow}"
                                   FontFamily="{StaticResource Font.Montserrat}"
                                   FontSize="{StaticResource Font.Size.HeroTitleMain}"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource Brush.Theme.Foreground}"
                                   Text="9-1-1 REALITY" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,-6,0,0"
                                   HorizontalAlignment="Center"
                                   Effect="{StaticResource Effect.HeroTitleInk}"
                                   FontFamily="{StaticResource Font.Montserrat}"
                                   FontSize="{StaticResource Font.Size.HeroTitleAccent}"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource Brush.Theme.Foreground}"
                                   Text="SIMULATOR" />
                    </Grid>

                    <!--  ECG pulse line - wider + stronger bloom  -->
                    <Path x:Name="EcgPulseLine"
                          Width="620"
                          Height="36"
                          Margin="0,10,0,0"
                          HorizontalAlignment="Center"
                          Data="{StaticResource Icon.PulseLine}"
                          Stretch="Fill"
                          Stroke="{StaticResource Brush.Brand.Orange}"
                          StrokeEndLineCap="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="3">
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              Opacity="0.95"
                                              ShadowDepth="0"
                                              Color="#FFFF6A00" />
                        </Path.Effect>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.55"
                                                         To="1.00"
                                                         Duration="0:0:1.20">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>

                    <!--  START SIMULATION label  -->
                    <TextBlock Margin="0,16,0,8"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource Font.Montserrat}"
                               FontSize="{StaticResource Font.Size.SectionLabel}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Theme.Foreground}"
                               Text="START SIMULATION" />

                    <!--  START button with floor-glow underneath  -->
                    <Grid HorizontalAlignment="Center">
                        <Ellipse Width="320"
                                 Height="50"
                                 Margin="0,40,0,0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0.00" Color="#88FF7A00" />
                                    <GradientStop Offset="1.00" Color="#00000000" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Button Content="START" Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>

                    <!--  System status row  -->
                    <ContentControl Margin="0,20,0,4"
                                    Content="SYSTEM STATUS:"
                                    Style="{StaticResource StatusPill.System}"
                                    Tag="READY" />

                    <!--  Scenario state lines  -->
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource Font.Montserrat}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource Brush.Brand.Orange}"
                               Text="NO SCENARIO LOADED" />
                    <TextBlock Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource Font.Montserrat}"
                               FontSize="18"
                               FontWeight="Medium"
                               Foreground="{DynamicResource Brush.Theme.Foreground.Soft}"
                               Text="AWAITING INSTRUCTOR" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
