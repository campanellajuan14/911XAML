<Window x:Class="NineOneOneReality.Launcher.Views.ActiveDarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:assist="clr-namespace:NineOneOneReality.Launcher"
        Title="9-1-1 Reality Simulator (Active - Dark)"
        Width="1920"
        Height="1080"
        MinWidth="1280"
        MinHeight="720"
        Background="{DynamicResource Brush.Theme.Background}"
        FontFamily="{StaticResource Font.Montserrat}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Loaded="OnWindowLoaded">

    <!--
        ACTIVE DARK SCREEN  (M1 - Alignment Proof)
        ========================================================================
        Implements the four polish directions requested by the client after
        the prototype review:

          1. Cinematic depth   - layered atmospheric backgrounds (warm horizon,
                                  diagonal haze, scanline overlay, multi-stop
                                  radial spotlight). Reserved slot for the
                                  artist's `cityscape-active-source.png` master.
          2. Glow layering     - multi-pass DropShadowEffects on the title, an
                                  orange halo behind the wordmark, intensified
                                  ECG bloom, floor-glow under the START button.
          3. Sidebar           - full-height rail #030404, left-only rounding, machine
                                  row + nav (brand strip in top bar), no selection bar.
          4. Hero scale        - centered white wordmark from client SVG (PNG),
                                  no duplicate "9-1-1 REALITY SIMULATOR" titling.

        Theme architecture unchanged: Theme.Dark.xaml is merged at the Window
        level so a parallel Light window can swap it for Theme.Light.xaml and
        share every other dictionary unchanged.
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Theme.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Hairline divider used between sidebar sections.  -->
            <Style x:Key="Sidebar.Divider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="20,12,20,12" />
                <Setter Property="Background" Value="{DynamicResource Brush.Theme.Border.Subtle}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ========== SIDEBAR (full window height; demo reference).  ========== -->
        <Border Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Background="Transparent"
                    Padding="0">
            <Border Background="{DynamicResource Brush.Theme.Sidebar}"
                        BorderBrush="{DynamicResource Brush.Theme.Sidebar.Frame}"
                        BorderThickness="0"
                        CornerRadius="14,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--  0  brand block (role identifier)  -->
                        <RowDefinition Height="Auto" />
                        <!--  1  divider  -->
                        <RowDefinition Height="Auto" />
                        <!--  2  primary nav  -->
                        <RowDefinition Height="Auto" />
                        <!--  3  divider  -->
                        <RowDefinition Height="Auto" />
                        <!--  4  TRAINING RESOURCES section  -->
                        <RowDefinition Height="*" />
                        <!--  5  spacer that pushes SYSTEM down  -->
                        <RowDefinition Height="Auto" />
                        <!--  6  divider  -->
                        <RowDefinition Height="Auto" />
                        <!--  7  SYSTEM section  -->
                        <RowDefinition Height="Auto" />
                        <!--  8  INSTRUCTOR footer  -->
                    </Grid.RowDefinitions>

                    <!--  0  Machine identity (product strip lives in the header bar).  -->
                    <StackPanel Grid.Row="0" Margin="14,18,14,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42"
                                    Height="42"
                                    Background="#FF1A1A1A"
                                    CornerRadius="21">
                                <Path Width="26"
                                      Height="26"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource Icon.HeadsetBadge}"
                                      Fill="{StaticResource Brush.Brand.Orange}"
                                      Stretch="Uniform" />
                            </Border>
                            <TextBlock x:Name="RoleComputerNameText"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Montserrat}"
                                       FontSize="{StaticResource Font.Size.SidebarBrand}"
                                       FontWeight="ExtraBold"
                                       Foreground="{StaticResource Brush.Brand.Orange}"
                                       Text="COMPUTER"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <!--  1  divider  -->
                    <Border Grid.Row="1" Style="{StaticResource Sidebar.Divider}" />

                    <!--  2  Primary nav  -->
                    <StackPanel Grid.Row="2" Margin="0,4,0,4">
                        <RadioButton Content="Dashboard"
                                     Checked="OnDashboardNavChecked"
                                     Unchecked="OnDashboardNavUnchecked"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.Dashboard}" />
                        <RadioButton Content="Start Simulation"
                                     IsChecked="True"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.StartSimulation}" />
                        <RadioButton Content="User Manuals / IT Info"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.UserManuals}" />
                        <RadioButton Content="Video Tutorials"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.VideoTutorials}" />
                        <RadioButton Content="Listen To Recordings"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.ListenToRecordings}" />
                        <RadioButton Content="Settings"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.Settings}" />
                    </StackPanel>

                    <!--  3  divider  -->
                    <Border Grid.Row="3" Style="{StaticResource Sidebar.Divider}" />

                    <!--  4  Training resources section  -->
                    <StackPanel Grid.Row="4">
                        <TextBlock Margin="28,0,14,10"
                                   FontFamily="{StaticResource Font.Montserrat}"
                                   FontSize="{StaticResource Font.Size.NavSection}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Brand.Orange}"
                                   Text="TRAINING RESOURCES" />
                        <RadioButton GroupName="TrainingNav"
                                     assist:NavIconAssist.IdleFill="{StaticResource Brush.NavIcon.Layers}"
                                     Content="Welcome - Start Here"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.StartHere}" />
                        <RadioButton GroupName="TrainingNav"
                                     assist:NavIconAssist.IdleFill="{StaticResource Brush.NavIcon.Cube}"
                                     Content="9-1-1 Academy / AI"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.Academy}" />
                    </StackPanel>

                    <!--  6  divider (Row 5 is spacer)  -->
                    <Border Grid.Row="6" Style="{StaticResource Sidebar.Divider}" />

                    <!--  7  System section  -->
                    <StackPanel Grid.Row="7">
                        <TextBlock Margin="28,0,14,10"
                                   FontFamily="{StaticResource Font.Montserrat}"
                                   FontSize="{StaticResource Font.Size.NavSection}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Brand.Orange}"
                                   Text="SYSTEM" />
                        <RadioButton GroupName="SystemNav"
                                     assist:NavIconAssist.IdleFill="{StaticResource Brush.NavIcon.Restart}"
                                     Content="Restart"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.Restart}" />
                        <RadioButton GroupName="SystemNav"
                                     assist:NavIconAssist.IdleFill="{StaticResource Brush.NavIcon.Shutdown}"
                                     Content="Shutdown"
                                     Style="{StaticResource NavButtonStyle}"
                                     Tag="{StaticResource Icon.Shutdown}" />
                    </StackPanel>

                    <!--  8  INSTRUCTOR role chip (client reference).  -->
                    <Border Grid.Row="8"
                            Margin="14,16,14,18"
                            Padding="12,10"
                            Background="Transparent"
                            BorderBrush="#CCFFFFFF"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Viewbox Width="22"
                                     Height="22"
                                     VerticalAlignment="Center"
                                     SnapsToDevicePixels="True"
                                     UseLayoutRounding="True">
                                <Canvas Width="24"
                                        Height="24"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <Ellipse Canvas.Left="2"
                                             Canvas.Top="2"
                                             Width="20"
                                             Height="20"
                                             Fill="Transparent"
                                             Stroke="{DynamicResource Brush.Theme.Foreground}"
                                             StrokeThickness="1.35" />
                                    <Ellipse Canvas.Left="9"
                                             Canvas.Top="8"
                                             Width="5"
                                             Height="5"
                                             Fill="Transparent"
                                             Stroke="{DynamicResource Brush.Theme.Foreground}"
                                             StrokeThickness="1.35" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <Path Data="M5.75,17.75 Q12,13.75 18.25,17.75"
                                          Fill="Transparent"
                                          Stroke="{DynamicResource Brush.Theme.Foreground}"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.35" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Montserrat}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Theme.Foreground}"
                                       Text="INSTRUCTOR" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!--  =================================================================
              HEADER (column 1): demo brand left + status / clock right.
              ================================================================= -->
        <ContentControl Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource HeaderBarStyle.Active}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Demo: orange chip + white silhouette + "911 REALITY SIMULATOR".  -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="40"
                            Height="40"
                            Background="{StaticResource Brush.Brand.Orange}"
                            CornerRadius="20">
                        <Path Width="22"
                              Height="22"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{StaticResource Icon.UserAvatar.Outline}"
                              Fill="#FFFFFFFF"
                              Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource Font.Montserrat}"
                                   FontSize="16"
                                   FontWeight="ExtraBold">
                            <Run Foreground="{StaticResource Brush.Brand.Orange}"
                                 Text="911" />
                            <Run Foreground="{DynamicResource Brush.Theme.Foreground}"
                                 Text=" REALITY SIMULATOR" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!--  Right: simulation status + clock  -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ContentControl Content="SIMULATION:"
                                    Style="{StaticResource StatusPill.Header}"
                                    Tag="READY" />
                    <TextBlock Margin="36,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Montserrat}"
                               FontSize="{StaticResource Font.Size.HeaderMeta}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource Brush.Theme.Foreground}"
                               Text="11:23 AM" />
                </StackPanel>
            </Grid>
        </ContentControl>

        <!--  ========== HERO PANEL ==========
                  Cinematic-depth layer order (bottom to top):
                    L1   dark base                       (Window background)
                    L2   tiled vector grid               (DrawingBrush, subtle)
                    L3   warm horizon glow at the bottom (suggests city lights)
                    L4   diagonal atmospheric haze       (top-left -> bottom-right)
                    L5   cityscape silhouette PLACEHOLDER  (reserved slot for
                                                            artist's PNG)
                    L6   multi-stop radial spotlight     (warm halo behind logo)
                    L7   scanline overlay                (per City Scape doc)
                    L8   vignette                        (legibility frame)
                    L9   hero chrome (centered wordmark, ECG, button, status)
                  ============================================================ -->
        <Grid Grid.Row="1"
                  Grid.Column="1"
                  ClipToBounds="True">

            <!--  L2  vector grid texture  -->
            <Rectangle>
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile"
                                      Viewport="0,0,56,56"
                                      ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#1FFF7A00" Thickness="0.5" />
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="56,0" />
                                        <LineGeometry StartPoint="0,0" EndPoint="0,56" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!--  L3  warm horizon glow at the bottom edge - the cinematic
                      "city lights below" feel without needing the artwork.  -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Offset="0.00" Color="#00000000" />
                        <GradientStop Offset="0.62" Color="#00000000" />
                        <GradientStop Offset="0.85" Color="#22FF7A00" />
                        <GradientStop Offset="1.00" Color="#44FF6600" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!--  L4  diagonal atmospheric haze  -->
            <Rectangle IsHitTestVisible="False" Opacity="0.6">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0.00" Color="#10FF9A40" />
                        <GradientStop Offset="0.50" Color="#00000000" />
                        <GradientStop Offset="1.00" Color="#15FF6600" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!--  L5  cityscape background.
                      Artist-supplied dark-base + orange-road-glow PNG. Stretched
                      to fill the hero pane edge-to-edge and held at low opacity
                      so it sits behind the dashboard UI without competing with
                      the title, ECG, or START button. A vertical soft mask
                      fades the top and bottom edges so the image blends into
                      the dark base instead of cutting hard.

                      File: Resources/Images/citymap_dark_4k.png
                      (Awaiting 3840 x 2160 re-export from client's artist;
                       the current 1002 x 558 source renders fine on 1080p and
                       will get sharper automatically when the higher-res file
                       drops into the same path.)  -->
            <Image IsHitTestVisible="False"
                       Opacity="0.42"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="/Resources/Images/citymap_dark_4k.png"
                       Stretch="UniformToFill">
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.00" Color="#00000000" />
                        <GradientStop Offset="0.18" Color="#FF000000" />
                        <GradientStop Offset="0.82" Color="#FF000000" />
                        <GradientStop Offset="1.00" Color="#00000000" />
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>

            <!--  L6  multi-stop radial spotlight behind the hero stack.
                      Three stops give a softer falloff than the prototype's
                      two-stop version - this is the main "depth" contribution.  -->
            <Ellipse Width="1200"
                         Height="780"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.45">
                        <GradientStop Offset="0.00" Color="#3DFF7A00" />
                        <GradientStop Offset="0.30" Color="#22FF7A00" />
                        <GradientStop Offset="0.65" Color="#0AFF7A00" />
                        <GradientStop Offset="1.00" Color="#00000000" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!--  L7  scanline overlay - very subtle 1px horizontal lines
                      every 3px, mimicking the optional pattern called out in
                      City Scape for all.odt.  -->
            <Rectangle IsHitTestVisible="False" Opacity="0.20">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile"
                                      Viewport="0,0,1,3"
                                      ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#08FF7A00"
                                                 Geometry="M 0,0 H 1 V 1 H 0 Z" />
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!--  L8  vignette  -->
            <Rectangle Fill="{DynamicResource Brush.Theme.HeroVignette}"
                           IsHitTestVisible="False" />

            <!--  L9  hero content  -->
            <Grid>
                <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                    <StackPanel.RenderTransform>
                        <!--  Nudge stack after reorder (pulse + actions above wordmark).  -->
                        <TranslateTransform Y="28" />
                    </StackPanel.RenderTransform>

                    <!--  ECG + start block above the wordmark (looser reference: fewer status lines).  -->
                    <Path x:Name="EcgPulseLine"
                          Width="680"
                          Height="40"
                          Margin="0,0,0,6"
                          HorizontalAlignment="Center"
                          Data="{StaticResource Icon.PulseLine}"
                          Stretch="Fill"
                          Stroke="{StaticResource Brush.Brand.Orange}"
                          StrokeEndLineCap="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="3">
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              Opacity="0.95"
                                              ShadowDepth="0"
                                              Color="#FFFF6A00" />
                        </Path.Effect>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.55"
                                                         To="1.00"
                                                         Duration="0:0:1.20">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>

                    <TextBlock Margin="0,0,0,8"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource Font.Montserrat}"
                               FontSize="{StaticResource Font.Size.SectionLabel}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Theme.Foreground}"
                               Text="START SIMULATION" />

                    <Grid HorizontalAlignment="Center">
                        <Ellipse Width="320"
                                 Height="50"
                                 Margin="0,40,0,0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0.00" Color="#88FF7A00" />
                                    <GradientStop Offset="1.00" Color="#00000000" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Button Content="START" Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>

                    <ContentControl Margin="0,20,0,32"
                                    Content="SYSTEM STATUS:"
                                    Style="{StaticResource StatusPill.System}"
                                    Tag="READY" />

                    <!--  Centered white wordmark (rasterized from client 911 reality.svg).  -->
                    <Grid Width="1200"
                          Height="480"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,0">
                        <Ellipse Width="1140"
                                 Height="440"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0.00" Color="#55FF7A00" />
                                    <GradientStop Offset="0.60" Color="#15FF7A00" />
                                    <GradientStop Offset="1.00" Color="#00000000" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Image MaxWidth="1140"
                               MaxHeight="440"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="/Resources/Images/911-reality-logo-hero-white.png"
                               Stretch="Uniform">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="22"
                                                  Opacity="0.55"
                                                  ShadowDepth="0"
                                                  Color="#FFFF7A00" />
                            </Image.Effect>
                        </Image>
                    </Grid>
                </StackPanel>
            </Grid>

            <!--  Hero top rule: fixed-width centered accent (same spirit as HeaderBar
                      separator). Full-stretch gradient read as a long yellow band on wide
                      layouts; width is independent of sidebar selection / window size.  -->
            <Grid Width="280"
                      Height="4"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      IsHitTestVisible="False">
                <Rectangle Height="1"
                               VerticalAlignment="Center"
                               Opacity="0.5">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0.0" Color="#00000000" />
                            <GradientStop Offset="0.42" Color="#55FF7A00" />
                            <GradientStop Offset="0.58" Color="#55FF7A00" />
                            <GradientStop Offset="1.0" Color="#00000000" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="180"
                               Height="2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Fill="{StaticResource Brush.Brand.Orange.Bright}"
                               Opacity="0.95">
                    <Rectangle.Effect>
                        <DropShadowEffect BlurRadius="14"
                                              Opacity="0.88"
                                              ShadowDepth="0"
                                              Color="#FFFFCC66" />
                    </Rectangle.Effect>
                </Rectangle>
            </Grid>
        </Grid>
    </Grid>
</Window>
