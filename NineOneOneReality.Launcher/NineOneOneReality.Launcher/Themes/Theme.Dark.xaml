<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        DARK theme palette and brushes. A Window merges this dictionary
        once at the Window.Resources level; ControlTemplates resolve
        every Brush.Theme.* via DynamicResource so they pick up the
        right palette automatically.

        All hex values are taken from the spec PDF or sampled directly
        from the source PNG ("Active Screen with city scape added.png").
    -->

    <!--  ===== Color palette ===== -->

    <Color x:Key="Color.Theme.Background">#FF050505</Color>
    <!--  near-black main background; spec MapBlack  -->

    <Color x:Key="Color.Theme.Surface">#FF0B0B0B</Color>
    <!--  card / panel background; spec MapDarkCharcoal  -->

    <Color x:Key="Color.Theme.Surface.Elevated">#FF141414</Color>
    <!--  hover and focus overlay surfaces  -->

    <!--  Opaque sidebar: sampled from client reference (#030404).  -->
    <Color x:Key="Color.Theme.Sidebar">#FF030404</Color>

    <Color x:Key="Color.Theme.Sidebar.Frame">#00000000</Color>

    <Color x:Key="Color.Theme.Sidebar.ItemHover">#FF2A2D33</Color>
    <Color x:Key="Color.Theme.Sidebar.ItemSelected">#FF35373E</Color>

    <Color x:Key="Color.Theme.Border">#FF2A2A2A</Color>
    <Color x:Key="Color.Theme.Border.Subtle">#FF1A1A1A</Color>
    <Color x:Key="Color.Theme.Divider.Orange">#80FF7A00</Color>
    <!--  semi-transparent orange separator under header  -->

    <Color x:Key="Color.Theme.Foreground">#FFFFFFFF</Color>
    <Color x:Key="Color.Theme.Foreground.Soft">#FFE8E8E8</Color>
    <Color x:Key="Color.Theme.Foreground.Muted">#FFB8B8B8</Color>
    <Color x:Key="Color.Theme.Foreground.Subtle">#FF8F8F8F</Color>

    <Color x:Key="Color.Theme.IconNeutral">#FFE8E8E8</Color>
    <!--  default sidebar icon stroke color in dark theme  -->

    <Color x:Key="Color.NavIcon.Layers">#FF26C6DA</Color>
    <Color x:Key="Color.NavIcon.Cube">#FFAB47BC</Color>
    <Color x:Key="Color.NavIcon.Restart">#FF29B6F6</Color>
    <Color x:Key="Color.NavIcon.Shutdown">#FFEF5350</Color>

    <Color x:Key="Color.Theme.UserAvatar.Bg">#FF2A2D33</Color>
    <Color x:Key="Color.Theme.UserAvatar.Border">#FF4A4D54</Color>

    <!--  ===== Brushes ===== -->

    <SolidColorBrush x:Key="Brush.Theme.Background" Color="{StaticResource Color.Theme.Background}" />
    <SolidColorBrush x:Key="Brush.Theme.Surface" Color="{StaticResource Color.Theme.Surface}" />
    <SolidColorBrush x:Key="Brush.Theme.Surface.Elevated" Color="{StaticResource Color.Theme.Surface.Elevated}" />

    <SolidColorBrush x:Key="Brush.Theme.Sidebar" Color="{StaticResource Color.Theme.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Theme.Sidebar.Frame" Color="{StaticResource Color.Theme.Sidebar.Frame}" />
    <SolidColorBrush x:Key="Brush.Theme.Sidebar.ItemHover" Color="{StaticResource Color.Theme.Sidebar.ItemHover}" />
    <SolidColorBrush x:Key="Brush.Theme.Sidebar.ItemSelected" Color="{StaticResource Color.Theme.Sidebar.ItemSelected}" />

    <SolidColorBrush x:Key="Brush.Theme.Border" Color="{StaticResource Color.Theme.Border}" />
    <SolidColorBrush x:Key="Brush.Theme.Border.Subtle" Color="{StaticResource Color.Theme.Border.Subtle}" />
    <SolidColorBrush x:Key="Brush.Theme.Divider.Orange" Color="{StaticResource Color.Theme.Divider.Orange}" />

    <SolidColorBrush x:Key="Brush.Theme.Foreground" Color="{StaticResource Color.Theme.Foreground}" />
    <SolidColorBrush x:Key="Brush.Theme.Foreground.Soft" Color="{StaticResource Color.Theme.Foreground.Soft}" />
    <SolidColorBrush x:Key="Brush.Theme.Foreground.Muted" Color="{StaticResource Color.Theme.Foreground.Muted}" />
    <SolidColorBrush x:Key="Brush.Theme.Foreground.Subtle" Color="{StaticResource Color.Theme.Foreground.Subtle}" />

    <SolidColorBrush x:Key="Brush.Theme.IconNeutral" Color="{StaticResource Color.Theme.IconNeutral}" />

    <SolidColorBrush x:Key="Brush.NavIcon.Layers" Color="{StaticResource Color.NavIcon.Layers}" />
    <SolidColorBrush x:Key="Brush.NavIcon.Cube" Color="{StaticResource Color.NavIcon.Cube}" />
    <SolidColorBrush x:Key="Brush.NavIcon.Restart" Color="{StaticResource Color.NavIcon.Restart}" />
    <SolidColorBrush x:Key="Brush.NavIcon.Shutdown" Color="{StaticResource Color.NavIcon.Shutdown}" />

    <SolidColorBrush x:Key="Brush.Theme.UserAvatar.Bg" Color="{StaticResource Color.Theme.UserAvatar.Bg}" />
    <SolidColorBrush x:Key="Brush.Theme.UserAvatar.Border" Color="{StaticResource Color.Theme.UserAvatar.Border}" />

    <!--
        Dark-theme "scenario panel" gradient: a soft top-down vignette
        over the cityscape image so center text remains legible.
    -->
    <LinearGradientBrush x:Key="Brush.Theme.HeroVignette" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0.0" Color="#B3000000" />
        <GradientStop Offset="0.5" Color="#33000000" />
        <GradientStop Offset="1.0" Color="#B3000000" />
    </LinearGradientBrush>

</ResourceDictionary>
