<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        STATUS PILL
        ===========
        Used in two places on the active dark screen:
          - Header bar:  "SIMULATION:  READY"  (right-aligned)
          - Below the START button: "SYSTEM STATUS: READY" / "NO SCENARIO LOADED" / "AWAITING INSTRUCTOR"

        Implemented as a styled ContentControl whose template renders a row
        of: optional check icon + label + colored value. Color is theme-bound.

        Tag is used to carry the "value" text (e.g. "READY") because we want
        Content to carry the "label" text (e.g. "SIMULATION:").
        Foreground is applied to the value (Tag); label uses Foreground.Soft.
    -->

    <Style x:Key="StatusPill.Header" TargetType="{x:Type ContentControl}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Status.Green}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.HeaderMeta}"
                                   Foreground="{DynamicResource Brush.Theme.Foreground.Muted}"
                                   Text="{TemplateBinding Content}"
                                   VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0"
                                   Style="{StaticResource Text.HeaderMeta}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontWeight="Bold"
                                   Text="{TemplateBinding Tag}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatusPill.System" TargetType="{x:Type ContentControl}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Status.Green}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Width="22"
                              Height="22"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center"
                              Data="{StaticResource Icon.CheckCircle}"
                              Fill="{TemplateBinding Foreground}"
                              Stretch="Uniform" />
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Montserrat}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Theme.Foreground.Soft}"
                                   Text="{TemplateBinding Content}" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Montserrat}"
                                   FontSize="20"
                                   FontWeight="ExtraBold"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Tag}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
