<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:assist="clr-namespace:NineOneOneReality.Launcher">

    <assist:NavIconIdleFillConverter x:Key="NavIconIdleFillConverter" />

    <!--
        NAV BUTTON
        ==========
        A sidebar nav row consisting of an icon + label, with idle / hover /
        selected / pressed states. Driven by RadioButton so each sidebar group
        keeps single-selection behaviour without code-behind.

        Required attached/exposed properties:
          - Tag          : Geometry of the icon (e.g. {StaticResource Icon.Dashboard})
          - Content      : the label text (e.g. "Dashboard")
          - IsChecked    : selected state (driven by GroupName binding)

        Theme dependence:
          - Foreground/icon = Brush.Theme.Foreground.Soft (idle)
          - Hover bg        = Brush.Theme.Sidebar.ItemHover
          - Selected        = Sidebar.ItemSelected pill + orange icon (no left accent bar)
    -->

    <Style x:Key="NavButtonStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="GroupName" Value="SidebarNav" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="14,3,14,3" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Theme.Foreground.Soft}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid>
                        <!--  Background pill (rounded)  -->
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="10"
                                SnapsToDevicePixels="True" />

                        <!--  Left accent bar removed (client: no yellow/orange strip on selection).  -->

                        <!--  Content row: icon + label  -->
                        <Grid Margin="14,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Path x:Name="IconPath"
                                  Grid.Column="0"
                                  Width="22"
                                  Height="22"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{TemplateBinding Tag}"
                                  Stretch="Uniform">
                                <Path.Fill>
                                    <MultiBinding Converter="{StaticResource NavIconIdleFillConverter}">
                                        <Binding Path="(assist:NavIconAssist.IdleFill)"
                                                 RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="."
                                                 RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </Path.Fill>
                            </Path>

                            <TextBlock x:Name="LabelHost"
                                       Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Montserrat}"
                                       FontSize="{StaticResource Font.Size.NavItem}"
                                       FontWeight="Medium"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Content}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>

                        <!--
                            Hover (not selected). A Setter swap is used instead of a
                            ColorAnimation because Storyboard.Seal() forbids DynamicResource
                            inside animation values, and the hover background comes from a
                            Window-level theme dictionary (Brush.Theme.Sidebar.ItemHover)
                            that the App-level NavButton template can only resolve dynamically.
                            Animated color transitions on theme-bound brushes can be re-added
                            later via a per-element unfrozen SolidColorBrush + DoubleAnimation
                            on Opacity of an overlay layer.
                        -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Theme.Sidebar.ItemHover}" />
                        </Trigger>

                        <!--  Selected: pill background + tinted icon + emphasised text (no left bar).  -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Theme.Sidebar.ItemSelected}" />
                            <Setter TargetName="IconPath" Property="Fill" Value="{StaticResource Brush.Brand.Orange}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Theme.Foreground}" />
                        </Trigger>

                        <!--  Pressed: small downscale + slightly darker bg  -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Theme.Surface}" />
                        </Trigger>

                        <!--  Disabled  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
