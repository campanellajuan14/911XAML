<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        HEADER BAR
        ==========
        The top bar above the main content. Contains:
          Left:    user icon + "INSTRUCTOR 2"
          Center:  brand "911 REALITY SIMULATOR" mark
          Right:   "SIMULATION: READY" + clock + (date)

        Implemented as a re-usable UserControl-style template via ContentControl
        so each Window only writes 5 lines of XAML to drop a header.

        Exposed via attached properties so a Window can configure each slot
        without editing the template.
    -->

    <Style x:Key="HeaderBarStyle" TargetType="{x:Type ContentControl}">
        <Setter Property="Height" Value="78" />
        <Setter Property="Background" Value="{DynamicResource Brush.Theme.Background}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="2" />
                            <!--  orange separator  -->
                        </Grid.RowDefinitions>

                        <!--  Header row content is supplied by the Window via Content  -->
                        <ContentPresenter Grid.Row="0" Margin="32,0,32,0" />

                        <!--  Header accent line: left → center → right gold ramp  -->
                        <Grid Grid.Row="1" Height="2">
                            <Rectangle Fill="{StaticResource Brush.Header.AccentLine}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ACTIVE MAIN WINDOWS  (ActiveDark / ActiveLight)
        Same chrome as HeaderBarStyle but without the 2px orange rule inside this
        template (Active*Window.xaml adds a full-width under-header glow row in
        column 1 so it spans only the main pane, matching the demo reference).
    -->
    <Style x:Key="HeaderBarStyle.Active" TargetType="{x:Type ContentControl}">
        <Setter Property="Height" Value="78" />
        <Setter Property="Background" Value="{DynamicResource Brush.Theme.Background}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="32,0,32,0"
                                          VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
