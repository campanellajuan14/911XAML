<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:assist="clr-namespace:NineOneOneReality.Launcher"
                    xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf">

    <assist:NavIconIdleFillConverter x:Key="NavIconIdleFillConverter" />
    <assist:NavIconSlotVisibilityConverter x:Key="NavIconSlotVisibilityConverter" />
    <assist:NavIconSlotMultiVisibilityConverter x:Key="NavIconSlotMultiVisibilityConverter" />
    <assist:NavIconSvgUriConverter x:Key="NavIconSvgUriConverter" />

    <!--
        NAV BUTTON
        ==========
        A sidebar nav row consisting of an icon + label, with idle / hover /
        selected / pressed states. Driven by RadioButton so each sidebar group
        keeps single-selection behaviour without code-behind.

        Icon (first column), in priority order:
          - assist:NavIconAssist.SvgIcon   : pack URI to embedded SVG (SharpVectors SvgViewbox)
          - assist:NavIconAssist.BitmapIcon: pack URI to PNG (Image)
          - Tag                            : Geometry for vector Path

        - Content      : the label text (e.g. "Dashboard")
        - IsChecked    : selected state (driven by GroupName binding)

        Theme dependence:
          - Foreground/icon = Brush.Theme.Foreground.Soft (idle)
          - Hover (unchecked) = same as selected: Brush.Theme.Sidebar.RowSelectedTint, 4px orange left bar,
                                sharp full-width row, orange label + icon
          - Selected (IsChecked) = same chrome as hover; row margin is 0 horizontally so tint
                                reaches the sidebar edge while icon/text use inner Margin only.
          - NavButtonStyle.Dashboard (DashboardWindow sidebar only): same row tint + bar; label and Path/Svg
            stay theme neutrals on hover/checked (no orange/yellow text or icon tint).
    -->

    <Style x:Key="NavButtonStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="GroupName" Value="SidebarNav" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0,3,0,3" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Theme.Foreground.Soft}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid SnapsToDevicePixels="True">
                        <!--  Selected / hover row: full-width tint + left accent (no corner radius)  -->
                        <Border x:Name="SelectionFill"
                                Background="{DynamicResource Brush.Theme.Sidebar.RowSelectedTint}"
                                CornerRadius="0"
                                Opacity="0"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="SelectionBar"
                                Width="4"
                                HorizontalAlignment="Left"
                                Background="{StaticResource Brush.Brand.Orange}"
                                CornerRadius="0"
                                Opacity="0"
                                SnapsToDevicePixels="True" />

                        <!--  Content row: icon + label (inset only; row chrome is edge-to-edge).  -->
                        <Grid Margin="28,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  Width="22"
                                  Height="22"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <svgc:SvgViewbox x:Name="IconSvg"
                                                 Width="22"
                                                 Height="22"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 RenderOptions.BitmapScalingMode="HighQuality"
                                                 Stretch="Uniform"
                                                 UriSource="{Binding Path=(assist:NavIconAssist.SvgIcon),
                                                                      RelativeSource={RelativeSource TemplatedParent},
                                                                      Mode=OneWay,
                                                                      Converter={StaticResource NavIconSvgUriConverter}}">
                                    <svgc:SvgViewbox.Visibility>
                                        <MultiBinding Converter="{StaticResource NavIconSlotMultiVisibilityConverter}"
                                                      ConverterParameter="Svg">
                                            <Binding Path="(assist:NavIconAssist.SvgIcon)"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="(assist:NavIconAssist.BitmapIcon)"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </svgc:SvgViewbox.Visibility>
                                </svgc:SvgViewbox>

                                <Image x:Name="IconBitmap"
                                       Width="22"
                                       Height="22"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       SnapsToDevicePixels="True"
                                       Stretch="Uniform">
                                    <Image.Visibility>
                                        <MultiBinding Converter="{StaticResource NavIconSlotMultiVisibilityConverter}"
                                                      ConverterParameter="Bitmap">
                                            <Binding Path="(assist:NavIconAssist.SvgIcon)"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="(assist:NavIconAssist.BitmapIcon)"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Image.Visibility>
                                    <Image.Source>
                                        <Binding Path="(assist:NavIconAssist.BitmapIcon)"
                                                 RelativeSource="{RelativeSource TemplatedParent}"
                                                 Mode="OneWay" />
                                    </Image.Source>
                                </Image>

                                <Path x:Name="IconPath"
                                      Width="22"
                                      Height="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="{TemplateBinding Tag}"
                                      Stretch="Uniform">
                                    <Path.Visibility>
                                        <MultiBinding Converter="{StaticResource NavIconSlotMultiVisibilityConverter}"
                                                      ConverterParameter="Path">
                                            <Binding Path="(assist:NavIconAssist.SvgIcon)"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="(assist:NavIconAssist.BitmapIcon)"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Path.Visibility>
                                    <Path.Fill>
                                        <MultiBinding Converter="{StaticResource NavIconIdleFillConverter}">
                                            <Binding Path="(assist:NavIconAssist.IdleFill)"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="."
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Path.Fill>
                                </Path>
                            </Grid>

                            <TextBlock x:Name="LabelHost"
                                       Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Montserrat}"
                                       FontSize="{StaticResource Font.Size.NavItem}"
                                       FontWeight="Medium"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Content}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SelectionFill" Property="Opacity" Value="1" />
                            <Setter TargetName="SelectionBar" Property="Opacity" Value="1" />
                            <Setter TargetName="IconPath" Property="Fill" Value="{StaticResource Brush.Brand.Orange}" />
                            <Setter TargetName="IconBitmap" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8"
                                                      Opacity="0.65"
                                                      ShadowDepth="0"
                                                      Color="#FFFA7C00" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="IconSvg" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8"
                                                      Opacity="0.65"
                                                      ShadowDepth="0"
                                                      Color="#FFFA7C00" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Brand.Orange}" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SelectionFill" Property="Opacity" Value="1" />
                            <Setter TargetName="SelectionBar" Property="Opacity" Value="1" />
                            <Setter TargetName="IconPath" Property="Fill" Value="{StaticResource Brush.Brand.Orange}" />
                            <Setter TargetName="IconBitmap" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8"
                                                      Opacity="0.65"
                                                      ShadowDepth="0"
                                                      Color="#FFFA7C00" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="IconSvg" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8"
                                                      Opacity="0.65"
                                                      ShadowDepth="0"
                                                      Color="#FFFA7C00" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Brand.Orange}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SelectionFill" Property="Opacity" Value="0.82" />
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Dashboard sidebar: neutral label/icon; hover/checked still show row chrome (tint + bar only).  -->
    <Style x:Key="NavButtonStyle.Dashboard" TargetType="{x:Type RadioButton}">
        <Setter Property="GroupName" Value="SidebarNav" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0,3,0,3" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Theme.Foreground.Soft}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="SelectionFill"
                                Background="{DynamicResource Brush.Theme.Sidebar.RowSelectedTint}"
                                CornerRadius="0"
                                Opacity="0"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="SelectionBar"
                                Width="4"
                                HorizontalAlignment="Left"
                                Background="{StaticResource Brush.Brand.Orange}"
                                CornerRadius="0"
                                Opacity="0"
                                SnapsToDevicePixels="True" />
                        <Grid Margin="28,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"
                                  Width="22"
                                  Height="22"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <svgc:SvgViewbox x:Name="IconSvg"
                                                 Width="22"
                                                 Height="22"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 RenderOptions.BitmapScalingMode="HighQuality"
                                                 Stretch="Uniform"
                                                 UriSource="{Binding Path=(assist:NavIconAssist.SvgIcon),
                                                                      RelativeSource={RelativeSource TemplatedParent},
                                                                      Mode=OneWay,
                                                                      Converter={StaticResource NavIconSvgUriConverter}}">
                                    <svgc:SvgViewbox.Visibility>
                                        <MultiBinding Converter="{StaticResource NavIconSlotMultiVisibilityConverter}"
                                                      ConverterParameter="Svg">
                                            <Binding Path="(assist:NavIconAssist.SvgIcon)"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="(assist:NavIconAssist.BitmapIcon)"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </svgc:SvgViewbox.Visibility>
                                </svgc:SvgViewbox>
                                <Image x:Name="IconBitmap"
                                       Width="22"
