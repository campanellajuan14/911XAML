                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       SnapsToDevicePixels="True"
                                       Stretch="Uniform">
                                    <Image.Visibility>
                                        <MultiBinding Converter="{StaticResource NavIconSlotMultiVisibilityConverter}"
                                                      ConverterParameter="Bitmap">
                                            <Binding Path="(assist:NavIconAssist.SvgIcon)"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="(assist:NavIconAssist.BitmapIcon)"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Image.Visibility>
                                    <Image.Source>
                                        <Binding Path="(assist:NavIconAssist.BitmapIcon)"
                                                 RelativeSource="{RelativeSource TemplatedParent}"
                                                 Mode="OneWay" />
                                    </Image.Source>
                                </Image>
                                <Path x:Name="IconPath"
                                      Width="22"
                                      Height="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="{TemplateBinding Tag}"
                                      Stretch="Uniform">
                                    <Path.Visibility>
                                        <MultiBinding Converter="{StaticResource NavIconSlotMultiVisibilityConverter}"
                                                      ConverterParameter="Path">
                                            <Binding Path="(assist:NavIconAssist.SvgIcon)"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="(assist:NavIconAssist.BitmapIcon)"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Path.Visibility>
                                    <Path.Fill>
                                        <MultiBinding Converter="{StaticResource NavIconIdleFillConverter}">
                                            <Binding Path="(assist:NavIconAssist.IdleFill)"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="."
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Path.Fill>
                                </Path>
                            </Grid>
                            <TextBlock x:Name="LabelHost"
                                       Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Montserrat}"
                                       FontSize="{StaticResource Font.Size.NavItem}"
                                       FontWeight="Medium"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Content}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SelectionFill" Property="Opacity" Value="1" />
                            <Setter TargetName="SelectionBar" Property="Opacity" Value="1" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SelectionFill" Property="Opacity" Value="1" />
                            <Setter TargetName="SelectionBar" Property="Opacity" Value="1" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SelectionFill" Property="Opacity" Value="0.82" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
